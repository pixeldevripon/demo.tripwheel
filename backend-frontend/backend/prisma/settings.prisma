// ─────────────────────────────────────────────────────────────────────────────
// Core site information (singleton)
// ─────────────────────────────────────────────────────────────────────────────

model SiteInfo {
  id String @id @default("default")

  siteName         String? @default("")
  siteTagline      String? @default("")
  siteDescription  String? @default("")
  bookingFormStyle String? @default("v2")

  logo    String? @default("")
  favicon String? @default("")

  // Master 6.6 puts WhatsApp in the footer, error states, NeedHelp and
  // post-purchase email as standing surfaces, so a fresh install ships with the
  // support line on and pointed at the real number rather than dark and blank.
  // The flag stays an admin kill switch - every read still gates on it, and a
  // deliberate `false` is never overwritten.
  //
  // The number mirrors DEFAULT_WHATSAPP_NUMBER in
  // src/common/utils/whatsapp.util.ts - change both together.
  enableWhatsappChat Boolean? @default(true)
  whatsappNumber     String?  @default("+5999 5266046")
  // Master kill switch for the Instagram grid. The feed itself lives in
  // instagram.prisma — this only decides whether the public site renders it.
  // Defaults ON: the section is intended to show once tiles exist (the public
  // feed still gates on having tiles, so an empty feed never renders).
  // (`instagramWidgetId` was dropped with the third-party-embed approach.)
  //
  // NOT NULL on purpose. As a nullable column a NULL had to be read as SOME
  // default, and the read sites disagreed: the dashboard showed the box ticked
  // (`?? true`) while the public projection hid the section (`?? false`) - and
  // because the form only PATCHes when the value differs from what it read,
  // ticking the already-ticked box wrote nothing and the split never healed.
  enableInstagram    Boolean  @default(true)

  // "Your local host" — the small looping avatar beside the WhatsApp button in
  // the FAQ block. It lives in site info, NOT on the homepage record, because
  // that block renders on the home, destination and collection pages; putting
  // it on one page's record would leave the other two on a bundled file.
  // Null on either → the site keeps its bundled avatar.
  faqHostImage String? // still frame, and the video's poster
  faqHostVideo String? // short loop; without one the still shows alone

  faqs Json? @default("[]")

  @@map("site_info")
}

// ─────────────────────────────────────────────────────────────────────────────
// SEO meta tags (singleton)
// ─────────────────────────────────────────────────────────────────────────────

model SiteSEO {
  id String @id @default("default")

  metaTitle       String? @default("")
  metaDescription String? @default("")
  metaKeywords    String? @default("")
  canonicalUrl    String? @default("")
  robotsMeta      String? @default("")

  ogTitle       String? @default("")
  ogDescription String? @default("")
  ogImage       String? @default("")

  twitterTitle       String? @default("")
  twitterDescription String? @default("")
  twitterImage       String? @default("")

  googleAnalyticsId   String? @default("")
  googleTagManagerId  String? @default("")
  googleSearchConsole String? @default("")
  facebookPixelId     String? @default("")
  cookiebotCbid       String? @default("")
  schemaType          String? @default("")
  customSchema        String? @default("")
  autoGenerateSitemap String? @default("")
  robotsTxt           String? @default("")

  // Custom header/footer scripts are NOT here. They are one row each in
  // `CustomScript` (custom-scripts.prisma) so an admin adds, names, reorders
  // and switches off each snippet independently - two merged text blobs made
  // every edit a diff against everyone else's vendor code.

  @@map("site_seo")
}

