  updatedAt DateTime @updatedAt

  @@map("stripe_configuration")
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform payment settings (singleton) — which PSP takes the checkout charge
// ─────────────────────────────────────────────────────────────────────────────

/// The admin-selected checkout PSP. Exactly ONE provider charges travellers at
/// any time (Stripe inline Elements vs Mollie hosted redirect); the intent
/// endpoint branches on this row. Switching is never retroactive: existing
/// Payment rows keep their own `provider`, and webhooks/refunds route by the
/// ROW's provider, not this setting.
model PaymentSettings {
  id             String          @id @default("default")
  activeProvider PaymentProvider @default(STRIPE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Mollie configuration (singleton)
// ─────────────────────────────────────────────────────────────────────────────

model mollieConfiguration {
  id             String   @id @default("default")
  paymentLabel   String   @default("Mollie")
  apiKey         String   @default("")
  /// Mollie profile id (pfl_...) - NON-secret, needed by mollie.js in the
  /// browser to tokenize cards for the inline Components form. Empty = no
  /// inline card form; the checkout falls back to Mollie's hosted page.
  profileId      String   @default("")
  paymentMethods String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id])
  @@map("mollie_configuration")
}

// ─────────────────────────────────────────────────────────────────────────────
// Integrations configuration (singleton) — admin-only SECRETS for server-side
// integrations. Distinct from SiteSEO (which holds the PUBLIC ids: facebookPixelId,
// googleTagManagerId, googleAnalyticsId — read by the public frontend). Secrets here
// are ENCRYPTED at rest (crypto.util) and NEVER exposed to public reads. The env vars
// (META_CAPI_TOKEN, GOOGLE_TRANSLATE_*) remain a local-dev / first-boot fallback.
// ─────────────────────────────────────────────────────────────────────────────

model IntegrationsConfiguration {
  id String @id @default("default")

  // Meta Conversions API (server-side booking_complete). The Pixel ID is public and
  // lives in SiteSEO.facebookPixelId; only the access token is a secret.
  metaCapiToken    String? // encrypted
  metaCapiTestCode String? @default("") // test_event_code (non-secret)

  // Google Ads API (ad-conversion PRD phase 3c: cancellation retractions).
  // The conversion itself is reported browser-side by the GTM Ads tag with
  // Transaction ID = booking publicRef; the retraction identifies it by that
  // same order id. All five credential pieces must be present for the service
  // to fire (config-gated no-op otherwise). GOOGLE_ADS_* env vars remain the
  // local-dev / first-boot fallback (DB wins).
  googleAdsDeveloperToken     String? // encrypted (API Center token)
  googleAdsCustomerId         String? @default("") // non-secret; digits only, no dashes
  googleAdsLoginCustomerId    String? @default("") // non-secret; the manager (MCC) id when access runs through one
  googleAdsClientId           String? @default("") // OAuth client id (non-secret)
  googleAdsClientSecret       String? // encrypted
  googleAdsRefreshToken       String? // encrypted
  googleAdsConversionActionId String? @default("") // numeric id of the purchase conversion action

  // DEPRECATED (Gemini migration, 2026-07): Google Cloud Translation credentials.
  // No runtime consumer remains - kept only because a column drop is a destructive
  // migration for zero gain. Do not add new readers.
  googleTranslateApiKey    String? // encrypted
  googleTranslateProjectId String? @default("") // non-secret

  // AI translation - powers content entities AND review comments. Provider-
  // agnostic on purpose: the admin picks the provider in the dashboard and the
  // key/model belong to whichever provider is active. DB values win;
  // TRANSLATION_PROVIDER_NAME / TRANSLATION_API_KEY / TRANSLATION_MODEL env
  // are the local-dev / first-boot fallback.
  translationProvider String? @default("") // '' = env/code default (gemini); a PROVIDER_CATALOG key
  translationApiKey   String? // encrypted
  translationModel    String? @default("") // non-secret; blank = provider default
  translationBaseUrl  String? @default("") // non-secret; only for provider 'custom' (any OpenAI-compatible endpoint)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("integrations_configuration")
}

// ─────────────────────────────────────────────────────────────────────────────
// Recommendations display settings (singleton) — how many post-booking cards each
// surface shows. Admin-editable so the cap can change without a deploy; read by the
// public feed and the confirmation-email builder. The email default is lower on
// purpose (a shorter email).
// ─────────────────────────────────────────────────────────────────────────────

model RecommendationSettings {
  id String @id @default("default")

  /// Max recommendation cards on the thank-you page (1..10).
  thankYouPageLimit Int @default(3)

  /// Max recommendation cards in the confirmation email (1..10).
  confirmationEmailLimit Int @default(2)

  updatedAt DateTime @updatedAt

  @@map("recommendation_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Third-party platform reviews (Trustpilot / Google) — admin-configured
// (singleton). The fetched payload is cached here so public reads never hit
// the third-party API on the request path.
// ─────────────────────────────────────────────────────────────────────────────

model PlatformReviewsConfig {
  id String @id @default("default")

  // 'trustpilot' | 'google' — null = not configured
  provider   String?
  // Encrypted at rest (crypto.util) — Trustpilot API key / Google API key
  apiKey     String? @default("")
  // Trustpilot business-unit ID or Google Place ID
  businessId String? @default("")
  enabled    Boolean @default(false)

  // Where the section renders (page keys, e.g. ["homepage"])
  displayPages Json @default("[\"homepage\"]")

  // Normalized fetched payload + freshness stamp (lazy TTL refresh)
  cachedPayload Json?
  fetchedAt     DateTime?
  // Last fetch failure (surfaced to the admin; cleared on success)
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_reviews_config")
}

// ─────────────────────────────────────────────────────────────────────────────
// Email programme switchboard (singleton) — WP-H, plan §4 (pinned contract,
// PR #190)
// ─────────────────────────────────────────────────────────────────────────────

/// The dashboard email centre's settings row (EMAIL-IMPLEMENTATION-PLAN.md §4
/// WP-H). Every field is NULLABLE on purpose: null = "use the built-in
/// default / env fallback" — a zero-risk rollout where nothing changes until
/// an admin deliberately edits a value. `EmailSettingsService.resolve()` is
/// the single reader and owns the `stored ?? env ?? built-in` resolution.
///
/// Founder decisions (2026-08-11) baked into the shape:
///   - GROUP switches only. Booking emails (BK-1/BK-2/CX-1) are contractual
///     and always-on — NO switch exists for them, here or in any DTO.
///   - Copy stays locked in code; only timings/switches/addresses live here.
///   - Every schedule timing is dashboard-editable with the built-in value
///     as fallback (shown in parens below).
model EmailSettings {
  id String @id @default("default")

  // Group switches (null → default / env)
  marketingEnabled     Boolean? // MK1_ENABLED env, default false
  onboardingEnabled    Boolean? // default true — false kills the OB-3…OB-8 candidate queries ("not yet", no rows burned)
  calendarEmailEnabled Boolean? // CALENDAR_SYNC_AVAILABLE env, default false
  ob8PartnerOffer      Boolean? // default true (founder decision D6)

  // Addresses (null → env)
  salesEmail  String? // SALES_EMAIL ?? ADMIN_EMAIL
  mailReplyTo String? // MAIL_REPLY_TO
  ob6ReplyTo  String? // OB6_REPLY_TO ?? mailReplyTo

  // Onboarding timings (null → built-in)
  ob3DelayHours               Int? // 48
  ob4DelayDays                Int? // 7
  ob6DelayDays                Int? // 14
  ob7AfterLiveDays            Int? // 3
  ob8AfterLiveDays            Int? // 7
  pendingReminderBusinessDays Int? // 2

  // Send window for lifecycle nudges (null → built-in). MK-1 shares the
  // HOURS (any weekday); the weekday list applies to operator nudges only.
  windowWeekdays  String? // csv of lowercase day names; default "tue,wed,thu"
  windowStartHour Int? // 9  (America/Curacao)
  windowEndHour   Int? // 11

  // Marketing timing (null → built-in)
  mk1DelayHours Int? // 72

  updatedAt DateTime @updatedAt

  @@map("email_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Post-tour review request schedule (singleton)
// ─────────────────────────────────────────────────────────────────────────────

/// Admin-controlled cadence for the post-tour review invitation.
///
/// These were hardcoded constants until it became clear they are a business
/// decision, not an engineering one: the advisory is explicit that the
/// morning-after send is a LAUNCH DEFAULT TO A/B TEST, not a proven optimum (a
/// Journal of Marketing field study run partly on a guided-tours marketplace
/// found next-day reminders actually *reduce* review likelihood for experience
/// goods). Tuning that from the dashboard is the whole point.
///
/// `enabled` DEFAULTS TO FALSE and is the master switch. A job that mails real
/// customers must be switched on deliberately, once, by a person - never merely
/// by deploying the code that contains it.
model ReviewRequestSettings {
  id String @id @default("default")

  /// Master switch. Off means the job runs and does nothing.
  enabled Boolean @default(false)

  /// Local hour in the TOUR's timezone for the first touch (0-23).
  /// "The morning after" is a different absolute instant on every island.
  firstSendLocalHour Int @default(10)

  /// Days after the tour before the first touch. 1 = the morning after.
  firstSendDelayDays Int @default(1)

  /// Send the single reminder this many days after the first touch.
  /// 5-7 is better supported than a 72-hour nudge and matches TripAdvisor's
  /// roughly one-week practice.
  reminderAfterDays Int @default(5)

  /// Whether the single reminder is sent at all.
  reminderEnabled Boolean @default(true)

  /// Stop chasing a booking older than this. A very late invitation reads as
  /// spam rather than service.
  giveUpAfterDays Int @default(30)

  /// Max invitations processed per hourly run, so a backlog cannot monopolise
  /// the process or empty a mail quota in one pass.
  batchSize Int @default(200)

  updatedAt DateTime @updatedAt

  @@map("review_request_settings")
}
