# ──────────────────────────────────────────────────────────────────────────────
# COMPOSE-LEVEL env for the DEMO stack (docker-compose.yml).
# Copy to `.env` on the VPS and fill in. This file holds ONLY the infrastructure
# variables that docker-compose interpolates. The backend's own app secrets live
# in backend/.env.production (see backend/.env.production.example).
#
#   cp .env.example .env
#
# Full runbook: docs/operations/DEMO-DEPLOYMENT.md
# ──────────────────────────────────────────────────────────────────────────────

# ── Project isolation ─────────────────────────────────────────────────────────
# READ THIS ONE FIRST if production runs on the same VPS.
#
# Compose prefixes every volume, network and container with the project name,
# which by DEFAULT is the directory name - so isolation from production would
# rest on nothing but this folder being called what you expect. Set it
# explicitly and the demo can never attach to production's postgres-data.
#
# Verify before the first boot, because seeding against the wrong volume writes
# over live data while both containers look perfectly healthy:
#
#   docker compose config --format json \
#     | python3 -c 'import json,sys; print(json.load(sys.stdin)["name"])'
#   # must print: demo-tripwheel
COMPOSE_PROJECT_NAME=demo-tripwheel

# ── Postgres ──────────────────────────────────────────────────────────────────
# The compose `postgres` service is created with these credentials, and the
# backend's DATABASE_URL is assembled from them automatically - so changing them
# here is enough, and you must NOT set DATABASE_URL in backend/.env.production
# (compose overrides it, so yours would be silently ignored).
#
# Change them BEFORE the first `docker compose up`: Postgres only creates the
# user and database while its data directory is empty. Edit them once the volume
# exists and the container keeps the old credentials while the backend tries the
# new ones.
#
# The database NAME can stay `island_tours` - this is a different container and a
# different volume from production's, so it collides with nothing.
POSTGRES_USER=island
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=island_tours

# ── Redis ─────────────────────────────────────────────────────────────────────
# The compose `redis` service runs with --requirepass this value, and the
# backend connects with it. Generate: openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ── Backend container ─────────────────────────────────────────────────────────
# Host-side port the reverse proxy (Caddy or nginx) forwards to. 5150 rather than
# 5050, because production holds 5050 on this box.
#
# KEEP THE `127.0.0.1:` PREFIX. A bare port binds 0.0.0.0, and Docker writes its
# own iptables rules, so UFW will NOT protect you - the API would be reachable
# from the internet with no TLS. This value is the whole host side of the port
# mapping, prefix included.
BACKEND_PORT=127.0.0.1:5150

# Image tag (CI sets this to the git SHA; defaults to `latest` locally).
BACKEND_IMAGE_TAG=latest

# ── Seeding ───────────────────────────────────────────────────────────────────
# Set to `true` for the FIRST boot against an empty database. That run creates
# the admin user from ADMIN_EMAIL / ADMIN_PASSWORD in backend/.env.production,
# and without it there is no way to sign in.
#
# Set it back to `false` immediately afterwards, or every redeploy re-seeds and
# resets demo content you may be part-way through showing someone.
RUN_SEED=false

# ── pgAdmin, only if you use the `tools` profile ──────────────────────────────
# The pgadmin service is profile-gated, so it never starts on a deploy and these
# are unused until you run it deliberately:
#
#   docker compose --profile tools up -d pgadmin
#   ssh -N -L 8082:127.0.0.1:8082 vps        # then http://127.0.0.1:8082
#
# PGADMIN_PASSWORD has no default. The container fails to start without it,
# which is the correct behaviour: it fails loudly, and only on the one command
# that needs it. Generate: openssl rand -base64 24
#
# PGADMIN_EMAIL=admin@demo.tripwheel.io
# PGADMIN_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────────
# NODE_OPTIONS is empty by default in docker-compose.yml. Set it here only to
# turn something on for an investigation, e.g. --trace-deprecation.
# NODE_OPTIONS=
