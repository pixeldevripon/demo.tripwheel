# ─── Backend API ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL='https://api.islandtours.esenc.cloud'

# Must match the backend's INTERNAL_API_SECRET. Server-only; never NEXT_PUBLIC_.
INTERNAL_API_SECRET='set-me-to-the-backend-value'

# ─── Auth cookie scope ──────────────────────────────────────────────────────────
# MUST match backend/src/auth/auth.instance.ts crossSubDomainCookies.domain, which
# defaults to '.islandtours.esenc.cloud'. Read by proxy.ts, and ONLY to expire a
# malformed session cookie - a host-scoped delete would not match the
# domain-scoped cookie, so the strip would silently no-op and the user would sit
# in a redirect loop.
#
# A mismatch between this and the backend is a login loop. The dashboard and the
# backend must agree.
COOKIE_DOMAIN='.islandtours.esenc.cloud'

# ─── Public cache revalidation ──────────────────────────────────────────────────
# The public site's /api/revalidate route. Dashboard writes POST their cache tags
# here; without it the public site keeps serving stale pages until cacheLife
# expires, with no error anywhere. Unset in production = silent staleness.
REVALIDATE_TARGET_URL='https://islandtours.esenc.cloud/api/revalidate'

# MUST match REVALIDATE_SECRET in the public repo or every revalidation 401s.
# Server-only; never NEXT_PUBLIC_. 32+ chars.
# The public side accepts a comma-separated list, so rotate in two deploys:
# add the new value there -> switch this -> remove the old one there.
REVALIDATE_SECRET='set-me-to-the-public-site-value'

# ─── Optional ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_OPEN_WEATHER_API_KEY=''


#main public-facing site URL, used in the dashboard's "View public site" link. Unset = link is inert.
NEXT_PUBLIC_FACING_APP_URL='http://localhost:3000'


NEXT_PUBLIC_ADMIN_LOGIN_URL='http://localhost:3002'