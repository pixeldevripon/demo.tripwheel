# ─── Backend API ────────────────────────────────────────────────────────────────
# The NestJS backend. Dev: http://localhost:5050
# Interim production: https://api.islandtours.esenc.cloud
NEXT_PUBLIC_BACKEND_URL='http://localhost:5050'

# Server-only shared secret sent on SSR data fetches so the backend exempts this
# trusted origin from its per-IP throttle. Must match the backend's
# INTERNAL_API_SECRET. NOT prefixed NEXT_PUBLIC_ - it must never reach the
# browser. Read by lib/server/auth-headers.ts.
#
# Without it the dashboard's SSR requests share one egress IP with the browser
# and burn the same throttle bucket; a throttled 429 then reads as "no session"
# and bounces a logged-in user to /portal.
INTERNAL_API_SECRET='change-me-at-least-16-characters'

# ─── Optional ───────────────────────────────────────────────────────────────────
# Weather widget on the dashboard overview. Unset = the widget renders empty.
NEXT_PUBLIC_OPEN_WEATHER_API_KEY=''

# "View staging site" link target in the setup guide. Unset = the link is inert.
NEXT_PUBLIC_STAGING_APP_URL=''
