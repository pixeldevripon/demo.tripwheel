# ─── Local port map ─────────────────────────────────────────────────────────────
#   5050  backend (NestJS)
#   3000  public site      (island-tours repo)  <- REVALIDATE_TARGET_URL below
#   3001  this dashboard   (`pnpm dev` pins -p 3001)
#
# The dashboard MUST NOT take 3000: it is the public site's, and this app POSTs
# revalidations to it. The backend's CORS_ORIGINS has to list http://localhost:3001
# or every dashboard API call is blocked in the browser.

# ─── Backend API ────────────────────────────────────────────────────────────────
# The NestJS backend. Dev: http://localhost:5050
# Interim production: https://api.islandtours.esenc.cloud
NEXT_PUBLIC_BACKEND_URL='http://localhost:5050'

# Server-only shared secret sent on SSR data fetches so the backend exempts this
# trusted origin from its per-IP throttle. Must match the backend's
# INTERNAL_API_SECRET. NOT prefixed NEXT_PUBLIC_ - it must never reach the
# browser. Read by lib/server/auth-headers.ts.
#
# Without it the dashboard's SSR requests share one egress IP with the browser
# and burn the same throttle bucket; a throttled 429 then reads as "no session"
# and bounces a logged-in user to /portal.
INTERNAL_API_SECRET='change-me-at-least-16-characters'

# ─── Auth cookie scope ──────────────────────────────────────────────────────────
# DELIBERATELY UNSET IN DEV, and listed here only so it is not a surprise in
# production. `proxy.ts` reads it ONLY when NODE_ENV === 'production'; on
# localhost the session cookie is host-scoped and a domain would not match it.
# Setting it here therefore does nothing.
#
# In production it MUST equal the backend's cookie domain
# ('.islandtours.esenc.cloud') or login loops. See .env.production.example.
# COOKIE_DOMAIN=

# ─── Public cache revalidation ──────────────────────────────────────────────────
# Where to POST cache-tag invalidations after a dashboard write, so the public
# site drops its stale 'use cache' entries. This is the public site's
# /api/revalidate route - dev: whatever port the public app runs on.
#
# The dashboard and the public site are separate processes with separate caches,
# so this HTTP hop is the ONLY thing that busts the public cache. Leave it unset
# and revalidation is simply disabled: writes still succeed, the public site
# serves stale content until its cacheLife expires, and the process logs the
# reason once at first write. That is fine for local dashboard work; it is a
# silent staleness bug in production.
REVALIDATE_TARGET_URL='http://localhost:3000/api/revalidate'

# Shared secret for the above. MUST match REVALIDATE_SECRET in the public repo,
# or every revalidation 401s (logged, never retried - a 401 is a config bug, not
# a blip). Server-only; never NEXT_PUBLIC_.
#
# The public endpoint accepts a comma-separated list, so rotation is two ordinary
# deploys: add the new secret there, switch this over, then drop the old one.
REVALIDATE_SECRET='change-me-at-least-32-characters-long'

# ─── Optional ───────────────────────────────────────────────────────────────────
# Weather widget on the dashboard overview. Unset = the widget renders empty.
NEXT_PUBLIC_OPEN_WEATHER_API_KEY=''

# "View staging site" link target in the setup guide. Unset = the link is inert.
NEXT_PUBLIC_STAGING_APP_URL=''
