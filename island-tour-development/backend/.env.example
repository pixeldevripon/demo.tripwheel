PORT=5050
NODE_ENV='development'
FRONTEND_URL='http://localhost:3000'
# Comma-separated trusted origins — add more as needed
CORS_ORIGINS='http://localhost:3000,https://yourdomain.com'

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/island_tours"

# Better Auth
BETTER_AUTH_SECRET="change-me-must-be-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:5050"

# Admin Seeding
ADMIN_EMAIL="admin@islandtours.com"
ADMIN_PASSWORD="REPLACE_ME_MIN_12_CHARS"

# Email (Google SMTP)
# Requires an App Password from your Google Account if 2FA is enabled
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=[EMAIL_ADDRESS]
SMTP_PASS=bijg lihf yiem mimt
MAIL_FROM="Island Tours" <noreply@islandtours.com>


# Crypto 
ENCRYPTION_KEY=a3f1c2d4e5b6a7f8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2

# Cloudinary (Media Gallery)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis / Upstash (BullMQ background upload queue)
# ── Option A: Upstash Redis (production) ─────────────────────────────────────
# Paste the full rediss:// URL from your Upstash console.
# The module auto-detects this and enables TLS automatically.
UPSTASH_REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# ── Option B: Local Redis (development fallback) ──────────────────────────────
# Used only when UPSTASH_REDIS_URL is not set.
REDIS_HOST=localhost
REDIS_PORT=6379
