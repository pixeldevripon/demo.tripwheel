PORT=5050
NODE_ENV='development'
FRONTEND_URL='http://localhost:3000'
# Operator portal (dashboard app) incl. /portal path - the invite set-password
# email links to `${PORTAL_URL}/reset`. No trailing slash/dot/whitespace.
PORTAL_URL='http://localhost:3001/portal'
# Public traveller site origin - booking-email links (TYP, /bookings, cancel
# page). No trailing slash/dot/whitespace.
ISLAND_TOURS_URL='http://localhost:3000'
# Every browser origin allowed to call the API (comma-separated, no spaces).
# Feeds BOTH CORS (main.ts) and Better Auth trustedOrigins (auth.instance.ts), so
# a missing origin here is either a blocked fetch or a rejected sign-in.
#
# Two apps now, not one: 3000 = public site, 3001 = dashboard (its own repo, its
# own dev server - see tripwheel-x-islandtours-dashboard). The dashboard's API
# calls run in the BROWSER with credentials, so localhost:3001 is required or
# every dashboard request is CORS-blocked locally.
# Production example: CORS_ORIGINS='https://yourdomain.com,https://dashboard.yourdomain.com'
CORS_ORIGINS='http://localhost:3000,http://localhost:3001'

# Database
# Matches docker-compose.dev.yml defaults (user/pass/db = island/island/island_tours).
DATABASE_URL="your-database-connection-string-here"

# Better Auth
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-must-be-at-least-32-characters-long"
# Dev: http://localhost:5050 — Production: your Render backend URL
BETTER_AUTH_URL="http://localhost:5050"

# OPTIONAL. Public origin for API links opened outside the app (the confirmation
# email's "Add to calendar" .ics link). Defaults to BETTER_AUTH_URL; set only if the
# API is served from a different public host.
# PUBLIC_API_URL="http://localhost:5050"

# Trusted-origin bypass for the per-IP throttle. The SSR/build server (frontend)
# sends this as `x-internal-api-key` so its prerender bursts are not rate-limited.
# Must match the frontend's server-only INTERNAL_API_SECRET. Generate: openssl rand -base64 32
INTERNAL_API_SECRET="change-me-at-least-16-characters"
# Signs traveler session tokens (email + booking-reference login, full TYP,
# cancellation request). REQUIRED and dedicated - no fallback to
# BETTER_AUTH_SECRET, so the two token systems have independent keys.
# Generate: openssl rand -base64 32
TRAVELER_SESSION_SECRET="change-me-at-least-32-characters-long"

# Cross-app cache busting: sent as `x-revalidate-secret` to the public site's
# POST /api/revalidate when nightly jobs re-rank tours (target = ISLAND_TOURS_URL).
# Must be one of the values in the frontend's comma-separated REVALIDATE_SECRET.
# Optional in dev (skipped with a warning when unset). Generate: openssl rand -base64 32
REVALIDATE_SECRET="change-me-at-least-32-characters--"

# Google OAuth (optional — remove if not using Google sign-in)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Admin seeding + operations: this inbox also receives traveller cancellation
# requests from the /cancel/{publicRef} form (B3).
ADMIN_EMAIL="admin@islandtours.com"
ADMIN_PASSWORD="REPLACE_ME_MIN_12_CHARS"

# Hidden internal-management admin (optional): same powers as ADMIN_EMAIL but
# flagged isSystemAccount - never listed anywhere, immune to admin mutation.
# Unset = the seed skips it. Keep these credentials with the internal
# management department only.
SYSTEM_ADMIN_EMAIL="internal-admin@islandtours.com"
SYSTEM_ADMIN_PASSWORD="REPLACE_ME_MIN_12_CHARS"

# Email (Resend) - the only email configuration; there is no dashboard surface.
# The MAIL_FROM domain must be verified in your Resend account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM="Island Tours <noreply@tripwheel.app>"

# AI translation (content entities + LD32 review comments). Provider-agnostic:
# gemini | anthropic | openai | groq | openrouter | mistral | deepseek |
# custom - the key/model belong to the selected provider, and 'custom' +
# TRANSLATION_BASE_URL points at ANY OpenAI-compatible endpoint (Together,
# xAI, self-hosted Ollama, ...). OPTIONAL: leave unset and content/reviews
# simply display in the language they were written in. The dashboard
# (Settings > Integrations) values win over env. Provider defaults to gemini
# (key: https://aistudio.google.com/apikey, model default gemini-3.6-flash).
TRANSLATION_PROVIDER_NAME=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=
TRANSLATION_BASE_URL=

# Encryption (settings & operator OAuth token storage)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-char-hex-string-from-openssl-rand-hex-32

# Cloudinary (Media Gallery)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payments & Tracking (Phase 6)
# NOTE: Stripe API keys (secret/publishable/webhook secret) are NOT env vars —
# they live encrypted in the `stripe_configuration` table, set via Admin → Settings.
# Same for the Mollie API key (`mollie_configuration`); the checkout PSP is picked
# in Admin → Settings → Payments (payment_settings.activeProvider, default STRIPE).
# Mollie webhooks need a public https API origin (PUBLIC_API_URL/BETTER_AUTH_URL);
# on localhost no webhookUrl is sent and bookings settle on return instead.
#
# FX provider for the rate cache feed. 'static' (default) = the fixed FX_USD_TO_EUR
# dev rate below; 'ecb' = keyless ECB reference rates (Frankfurter, no API key).
# In non-production, 'ecb' falls back to the static rate if the provider is
# unreachable; in production it runs alone and cross-currency fails closed on an
# outage. The CHARGE rate comes from Stripe (payments phase), not this feed.
FX_PROVIDER=static
#
# FX spot rate USD → EUR for the EUR-normalized commission/conversion value
# (rule #22), and the 'static' provider's rate. Optional — defaults to 0.92 when unset.
FX_USD_TO_EUR=0.92
#
# Meta Conversions API (server-side `booking_complete`). Both must be set or the
# CAPI firer is a no-op. TEST_CODE is for Meta's Test Events tool (dev only).
META_PIXEL_ID=000000000000000
META_CAPI_TOKEN=EAAG...your-system-user-access-token
META_CAPI_TEST_CODE=TEST12345

# Redis (BullMQ broker: media uploads, notifications, nightly jobs)
# ── Local / self-hosted Redis (recommended - dev AND production) ──────────────
# Used whenever UPSTASH_REDIS_URL is unset. Matches docker-compose.dev.yml and
# the production `redis` service. In production set REDIS_PASSWORD to match the
# container's --requirepass; leave it blank for the password-less dev Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Upstash Redis (optional) ──────────────────────────────────────────────────
# A managed alternative. NOTE: the free tier caps total commands per day and
# BullMQ's constant polling exhausts it quickly - prefer self-hosted Redis.
# When set, this wins over REDIS_HOST/PORT and enables TLS automatically.
# UPSTASH_REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379