PORT=5050
NODE_ENV='development'
FRONTEND_URL='http://localhost:3000'
# Comma-separated trusted origins — add more as needed
# Production example: CORS_ORIGINS='https://yourdomain.com'
CORS_ORIGINS='http://localhost:3000,https://yourdomain.com'

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/island_tours"

# Better Auth
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-must-be-at-least-32-characters-long"
# Dev: http://localhost:5050 — Production: your Render backend URL
BETTER_AUTH_URL="http://localhost:5050"

# Google OAuth (optional — remove if not using Google sign-in)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Admin Seeding
ADMIN_EMAIL="admin@islandtours.com"
ADMIN_PASSWORD="REPLACE_ME_MIN_12_CHARS"

# Email (Google SMTP)
# Requires an App Password from your Google Account if 2FA is enabled
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="Island Tours" <noreply@islandtours.com>

# Encryption (settings & operator OAuth token storage)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-char-hex-string-from-openssl-rand-hex-32

# Cloudinary (Media Gallery)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payments & Tracking (Phase 6)
# NOTE: Stripe API keys (secret/publishable/webhook secret) are NOT env vars —
# they live encrypted in the `stripe_configuration` table, set via Admin → Settings.
#
# FX spot rate USD → EUR for the EUR-normalized commission/conversion value
# (rule #22). Optional — defaults to 0.92 when unset.
FX_USD_TO_EUR=0.92
#
# Meta Conversions API (server-side `booking_complete`). Both must be set or the
# CAPI firer is a no-op. TEST_CODE is for Meta's Test Events tool (dev only).
META_PIXEL_ID=000000000000000
META_CAPI_TOKEN=EAAG...your-system-user-access-token
META_CAPI_TEST_CODE=TEST12345

# Redis / Upstash (BullMQ background upload queue)
# ── Option A: Upstash Redis (recommended for production) ─────────────────────
# Paste the full rediss:// URL from your Upstash console.
# The module auto-detects this and enables TLS automatically.
UPSTASH_REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# ── Option B: Local Redis (development fallback) ──────────────────────────────
# Used only when UPSTASH_REDIS_URL is not set.
REDIS_HOST=localhost
REDIS_PORT=6379
