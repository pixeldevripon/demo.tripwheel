// ─────────────────────────────────────────────────────────────────────────────
// Instagram feed — the brand handle row + photo grid on destination pages
// (master §3.9: "Instagram grid: brand handle row per review").
//
// FIRST-PARTY BY DESIGN. The site renders this grid from our own rows, never
// from an embedded third-party widget: an iframe cannot be server-rendered into
// the `'use cache'` + PPR pipeline, drags in consent-banner cookies across six
// EU locales, and cannot be styled to the Figma grid. The old
// `SiteInfo.instagramWidgetId` was the abandoned start of that approach and is
// dropped in the same migration that adds these tables.
//
// AUTO-SYNC SHIPPED: the feed is a MIRROR of the connected account. An admin
// pastes a long-lived access token in the dashboard (configAccessToken), a daily
// job pulls the recent media, mirrors each asset into Cloudinary, and upserts
// these rows with `source = API` keyed on `igMediaId`. The manual picker is
// retired; the only curation left is reorder (`displayOrder`) and hide
// (`isActive`), both admin-owned and never touched by a re-sync. There is no
// OAuth - the token IS the credential. The public frontend never changed.
// ─────────────────────────────────────────────────────────────────────────────

/// The connected brand account (singleton, id 'default'). Holds what the header
/// row renders plus the API connection: the configured token (configAccessToken),
/// and the working connection seeded from it (igUserId, encrypted accessToken,
/// tokenExpiresAt, lastSyncedAt/Status/Error).
///
/// Separate from SocialMedia.instagramUrl on purpose: that row is the footer's
/// social icon list, a plain link set an admin can point anywhere. This is the
/// account the feed belongs to, and it holds the credential.
model InstagramAccount {
  id String @id @default("default")

  /// Handle WITHOUT the leading '@' (e.g. "island.tours_"). The section header
  /// renders '@' + this; storing it bare keeps the display decision in the UI.
  username String? @default("")

  /// Profile URL for the "View more on Instagram" link. Empty → the service
  /// derives https://www.instagram.com/{username}, so a correct username is
  /// enough on its own.
  profileUrl String? @default("")

  /// Which of the two public layouts renders the tiles. Lives here rather than
  /// on SiteInfo because it is a property of this feed, not a site-wide toggle.
  /// Defaults to GALLERY (the Instagram-profile look) - the intended default
  /// presentation for the brand feed.
  layout InstagramLayout @default(GALLERY)

  // ── Sync tuning (dashboard-configurable) ────────────────────────────────────

  /// How many recent posts each sync pulls in ONE request. Kept a little above
  /// the largest display cap (gallery = 15) so an admin has spares to
  /// reorder/hide. Bounded 1..25 (one Instagram media page) by the DTO; the sync
  /// clamps defensively too. Default 24.
  syncFetchLimit Int @default(24)

  /// Minutes between automatic syncs. The scheduler maps the allowed values to a
  /// cron kept at :30 past the hour, UTC (180 → every 3h, 360 → 6h, 720 → 12h,
  /// 1440 → daily 02:30). Changing it re-registers the cron live. Default 1440.
  syncIntervalMinutes Int @default(1440)

  // ── Dashboard-entered credential (overrides the env var when set) ───────────
  // Resolved DB-first-then-env by InstagramConfigService, mirroring how the
  // translation API key is configured. Null => fall back to INSTAGRAM_ACCESS_TOKEN.

  /// The long-lived access token entered in the dashboard, ENCRYPTED
  /// (crypto.util). The primary credential - overrides INSTAGRAM_ACCESS_TOKEN.
  /// It SEEDS the working connection below on the next sync.
  configAccessToken String?

  // ── Instagram API connection, seeded from the configured token ──────────────

  /// The connected account's Instagram-scoped user id, resolved from the token
  /// via GET /me. The media list is read from GET /{igUserId}/media.
  igUserId String?

  /// The 60-day long-lived access token, ENCRYPTED with crypto.util (ENCRYPTION_KEY)
  /// - never stored or logged in plaintext. Null when disconnected. The daily job
  /// refreshes it in place before it lapses.
  accessToken String?

  /// When `accessToken` expires. The refresh runs once this is inside ~10 days;
  /// past it the connection is dead and the admin must reconnect.
  tokenExpiresAt DateTime?

  /// Last time a sync run finished (success or not) - shown in the dashboard.
  lastSyncedAt DateTime?

  /// Outcome of that run, so the panel can flag a stale or failing connection.
  lastSyncStatus InstagramSyncStatus?

  /// Human-readable reason for a PARTIAL/FAILED/EXPIRING run. Null on OK. Never
  /// contains the token (only the API's error message).
  lastSyncError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("instagram_account")
}

/// One tile in the grid.
model InstagramPost {
  id     String          @id @default(uuid())
  source InstagramSource @default(MANUAL)

  /// Instagram's media id — null for MANUAL rows. Unique so a re-sync updates
  /// the existing tile instead of duplicating it.
  igMediaId String? @unique

  /// What the corner badge says the post is. VIDEO is DERIVED from videoUrl and
  /// never client-set (a tile must not claim to be a reel with no reel); with no
  /// video an admin picks IMAGE or CAROUSEL_ALBUM, since that badge describes
  /// the post being linked to, which we cannot see. The phase-2 sync sets it
  /// straight from Instagram's own media_type.
  mediaType InstagramMediaType @default(IMAGE)

  /// Reserved pinned-post marker (a corner badge). Currently ALWAYS false: the
  /// `instagram_business_basic` scope the sync uses does not expose a post's
  /// pinned state, so nothing populates this. Kept as a column so a future
  /// scope/design can light it up without a migration. If it is ever set, it is
  /// a BADGE ONLY and must never reorder the grid - displayOrder owns order.
  isPinned Boolean @default(false)

  /// Where the tile links. For MANUAL rows an admin pastes the post URL; empty
  /// is allowed and falls back to the account profile, so a tile is never a
  /// dead link.
  permalink String? @default("")

  caption String?

  /// The still the grid paints, always a URL WE control (media-library asset in
  /// phase 1, Cloudinary mirror in phase 2). Instagram's own `media_url` CDN
  /// links expire within days and hotlinking them is against their terms, so
  /// they are deliberately never stored here.
  ///
  /// REQUIRED even on a video tile, where it doubles as the poster: a video with
  /// no poster flashes black before its first frame, and it is what a reduced-
  /// motion visitor sees instead of the loop. (Same reason FeaturedExperience
  /// carries posterUrl beside videoUrl.)
  imageUrl      String
  /// Cloudinary public id, when the asset came from our gallery/mirror. Kept so
  /// phase 2 can clean up mirrored derivatives it created.
  imagePublicId String?

  /// The video for a reel/video post, null on a photo tile. Phase 2 maps
  /// Instagram's `media_url` here and its `thumbnail_url` into imageUrl.
  videoUrl      String?
  /// Cloudinary public id of the mirrored VIDEO asset (null on a photo tile).
  /// Symmetric with imagePublicId, so the sync can clean up a removed reel's
  /// derivative without parsing it back out of the URL.
  videoPublicId String?

  width  Int?
  height Int?

  /// Overrides the caption-derived alt text. Captions are marketing copy full of
  /// emoji and hashtags, which makes miserable alt text.
  altText String?

  /// When the post went up on Instagram (phase 2). Null for manual rows, which
  /// order purely by displayOrder.
  postedAt DateTime?
  /// Last time the API sync touched this row. Null for manual rows.
  syncedAt DateTime?

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  /// null = brand-wide, shown on every destination page. A pinned row shows
  /// only on its own destination (same rule as FeaturedExperience).
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@index([destinationId])
  @@map("instagram_posts")
}
