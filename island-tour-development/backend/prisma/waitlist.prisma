// Waitlist domain — FIFO queue per featured slot.
//
// When a slot is released, the first WAITING entry gets offered the slot for 24 hours.
// Critical Rule #10: Store offerJobId to cancel BullMQ job when offer is claimed or passed.

model WaitlistEntry {
  id         String         @id @default(uuid())
  slotId     String
  operatorId String
  tripId     String? // the trip the operator wants to publish
  status     WaitlistStatus @default(WAITING)

  joinedAt       DateTime  @default(now())
  offeredAt      DateTime?
  offerExpiresAt DateTime?
  claimedAt      DateTime?
  offerJobId     String? // BullMQ job ID — cancel when offer claimed/passed

  slot     FeaturedSlot @relation(fields: [slotId], references: [id])
  operator Operator     @relation(fields: [operatorId], references: [id])
  trip     Trip?        @relation(fields: [tripId], references: [id])

  @@index([slotId, status])
  @@index([operatorId])
  @@map("waitlist_entries")
}
