// Bookings domain — OCTO reserve → confirm lifecycle.
// Booking holds inventory (ON_HOLD + utcExpiresAt); confirm commits; expiry/cancel release.
// One BookingUnitItem per traveler, each priced at the TourAgeBand it was sold at.

model Booking {
  id   String @id @default(uuid())
  // OCTO-mirror only. `id` is THE idempotency key (reserve honours it with a
  // replay pre-check + in-flight P2002 catch, hardening F4); this column is
  // never consulted for dedup - do not assume it dedupes anything.
  uuid String @unique @default(uuid())

  tourId      String
  departureId String? // null when freesale
  operatorId  String
  userId      String? // guest auto-created; null until known

  // OCTO refs
  resellerReference String? // our display ref source
  supplierReference String? // operator/external ref
  publicRef         String  @unique @default(uuid()) // TYP url token
  displayRef        String  @unique // IT-2026-00042 (human)

  status   BookingStatus @default(ON_HOLD)
  freesale Boolean       @default(false)
  testMode Boolean       @default(false)

  // Lifecycle timestamps
  utcExpiresAt   DateTime?
  utcConfirmedAt DateTime?
  utcRedeemedAt  DateTime?

  // Snapshot at booking time
  paymentModel      PaymentModel
  // On-site payment terms snapshot; null unless paymentModel = ON_ARRIVAL (rule #21).
  onArrivalPayment  OnArrivalPayment?
  currency          Currency
  localDate         DateTime          @db.Date
  startTime         String?
  tourStartDateTime DateTime? // full local start instant (TYP range, ICS, reminder, deadline calc) — master E.8
  tourEndDateTime   DateTime? // local end = start + duration (TYP "8:00 AM – 5:00 PM") — master E.8
  tourTimeZone      String? // IANA zone snapshot (cancellation window + review eligibility stay correct if the tour/destination zone later changes)

  // Pickup (octo/pickups; D12)
  pickupRequested    Boolean  @default(false)
  pickupLocationId   String? // selected pickup point (null = no pickup / meet-on-site)
  pickupAddress      String? // snapshot of the selected pickup point address (booking immutability) — master E.8
  // Pickup TIMING snapshot (guide §17: later pickup edits must not mutate existing
  // bookings). Confirmation email renders these — joining PickupLocation live would
  // retroactively change the pickup time a confirmed traveler was already told.
  pickupMinutesPrior Int? // PickupLocation.minutesPrior at booking time
  pickupWindowStart  String? // 'HH:MM' — Figma "7:45–8:15 AM window"
  pickupWindowEnd    String? // 'HH:MM'
  // Pickup PRICE snapshot (booking currency): per-person zone price × pax, charged only
  // when the tour's pickupModel = PAID_ADDON at reserve time. Included in totalRetail.
  pickupUnitPrice    Decimal? @db.Decimal(10, 2) // per-person zone price at booking time
  pickupTotalPrice   Decimal? @db.Decimal(10, 2) // unitPrice × pax (the charged line)

  // Operator-conditions acceptance evidence (Pastel #80 / MCK-20 §4): the
  // stamp is the when, the booking's own contact fields are the who, and
  // operatorTermsVersion is the operator's termsVersion at acceptance (null
  // for the ACKNOWLEDGMENT flavor - there is no versioned document). A flagged
  // tour's booking cannot take a payment intent while acceptedAt is null:
  // the checkbox is the interface to that rule, the API is the rule.
  operatorTermsAcceptedAt DateTime?
  operatorTermsVersion    String?

  // UNIT + PRIVATE exclusivity (master E.3 "one booking takes the whole departure").
  // True when a private, unit-priced charter claims the entire departure; release
  // then frees the whole departure rather than the guest headcount.
  exclusiveDeparture Boolean @default(false)

  // Pricing snapshot (Decimal; minor units at boundary). `currency` above = booking/original currency.
  totalRetail      Decimal  @db.Decimal(10, 2)
  totalNet         Decimal? @db.Decimal(10, 2)
  commissionRate   Decimal? @db.Decimal(5, 4) // G2 — snapshot fraction, e.g. 0.2750 = tier 27.5%
  commissionAmount Decimal? @db.Decimal(10, 2) // EUR-normalized conversion value; null = corruption
  depositAmount    Decimal  @db.Decimal(10, 2)
  balanceAmount    Decimal  @db.Decimal(10, 2) // operator-collected balance
  taxes            Json?    @default("[]")

  // Coupon / discount (Figma "Apply" promo; applied in the original currency)
  couponCode     String?
  discountAmount Decimal? @db.Decimal(10, 2)

  // Multi-currency EUR normalization (G3 — conversion value must be EUR)
  totalEur    Decimal? @db.Decimal(10, 2) // totalRetail converted to EUR
  fxRateToEur Decimal? @db.Decimal(12, 6) // rate applied (currency → EUR) at booking time

  // Multi-currency source snapshot + FX audit (guide §20.2). `currency`/`totalRetail`/
  // `depositAmount`/`balanceAmount` above are the CHARGED/display currency; these preserve
  // the original tour-currency quote so the conversion is fully auditable and never redone.
  sourceCurrency        Currency?
  sourceTotalRetail     Decimal?  @db.Decimal(10, 2)
  sourceDepositAmount   Decimal?  @db.Decimal(10, 2)
  sourceBalanceAmount   Decimal?  @db.Decimal(10, 2)
  sourceFxRateToBooking Decimal?  @db.Decimal(12, 6) // rate: tourCurrency → bookingCurrency
  sourceFxProvider      String? // provider that supplied the source→booking rate
  sourceFxProviderAsOf  DateTime? // provider timestamp of the source→booking rate
  eurFxProvider         String? // provider that supplied the booking→EUR rate
  eurFxProviderAsOf     DateTime? // provider timestamp of the booking→EUR rate

  // Contact (OCTO Contact; guest override of User)
  contactFirstName    String?
  contactLastName     String?
  contactFullName     String?
  contactEmail        String?
  contactPhone        String?
  contactPostalCode   String?
  contactCountry      String?
  contactLocales      String[] @default([])
  notes               String? // "Special requests" — capped at 500 chars in the DTO
  newsletterOptIn     Boolean  @default(false) // Figma checkout marketing opt-in
  // WhatsApp consent for the post-tour review REMINDER only (never the first
  // touch, never marketing). WhatsApp Business requires prior opt-in plus an
  // approved non-promotional template, so without this captured at checkout the
  // reminder template is rejected and the job silently falls back to email.
  // Separate from `newsletterOptIn`: agreeing to a newsletter is not consent to
  // be messaged on WhatsApp.
  reviewWhatsappOptIn Boolean  @default(false)

  // Attribution + tracking (master tracking E.8; booking_complete contract)
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmTerm            String?
  utmContent         String?
  gclid              String? // Google Ads click id (offline conversions + adjustments; master E.8 / 8.3)
  gbraid             String? // Google iOS web-to-app
  wbraid             String? // Google app-to-web
  fbclid             String? // Meta click id
  affiliateId        String? // Trackdesk
  // Denormalized destination SLUG (master E.8, NOT NULL). NO DEFAULT ON PURPOSE:
  // it builds the thank-you deep link `/{island}/thank-you/{publicRef}` and the
  // page 404s on any mismatch with the URL segment, so there is no value that is
  // safe to guess. It used to default to "Curaçao" - a display NAME - and every
  // insert that omitted the field silently produced a booking whose thank-you
  // page was unreachable forever (312 such rows existed; see
  // `scripts/backfill-booking-island.ts`). Without a default, an omission is now
  // a loud NOT NULL violation at the database instead of a silent 404.
  island             String // denormalized destination slug for analytics (master E.8 NOT NULL)
  customerLocale     String? // locale at time of booking
  customerId         String? // hashed email (CAPI/advanced matching), not PII
  conversionFiredAt  DateTime? // mark-first idempotency for the SERVER fire (CAPI + email) at webhook/settle confirm (finalizeConfirmation)
  conversionPushedAt DateTime? // SEPARATE mark-first guard for the BROWSER booking_complete dataLayer push on the TYP (master 8.2). Distinct from conversionFiredAt, which is already set at confirm, so a browser push gated on it would never fire.

  // Billing snapshot from the payment method (G5; null on operator_full / on_arrival)
  billingCountry     String?
  billingPostalCode  String?
  billingCity        String?
  paymentMethodLast4 String?
  paymentMethodBrand String?

  // Cancellation
  cancellationRefund         CancellationRefund?
  cancelledBy                CancelledBy?
  cancellationReason         String?
  utcCancelledAt             DateTime?
  utcCancellationRequestedAt DateTime? // when the traveler requested cancellation; refund eligibility is judged at this instant, not the admin action time (gap #16, wired in package D)

  // Non-payment forfeit (guide s15, OPERATOR_LINK): the operator reports the balance
  // was never paid; only an admin confirmation forfeits the deposit (kept - commission
  // stays earned, settlement NOT reversed) and releases the spot. Never automatic.
  utcNonPaymentReportedAt DateTime?
  utcForfeitedAt          DateTime?

  // Operator-forced cancellation (access-roles matrix conflict #2): operators
  // REPORT a cancellation, only an admin executes it (the refund moves real
  // money). The stamp puts the booking on the admin worklist and holds the
  // settlement payout; admin either cancels (stamped cancelledBy=OPERATOR so
  // the eligibility metric counts it) or dismisses the report.
  utcOperatorCancellationReportedAt DateTime?
  operatorCancellationReason        String?

  // No-show (ad-conversion PRD phase 3f): the traveller never turned up. Same
  // report-then-confirm shape as the non-payment forfeit above - the operator
  // REPORTS, only an admin CONFIRMS - because "they didn't come" is one party's
  // word about an event with no system trace.
  //
  // A FLAG, NOT A BookingStatus. The tour ran, the seat was consumed and the
  // deposit is kept, so there is no state transition to make: the booking stays
  // CONFIRMED and gains a mark. Adding a status would have meant reworking every
  // state machine that reads one.
  //
  // NOTHING IS REPORTED TO THE AD PLATFORMS on confirmation, deliberately. The
  // kept deposit IS the commission (LD24), so the conversion value already
  // reported is still true - exactly the reasoning that makes the shipped
  // cancellation pipeline skip a NONE-refund cancellation. A no-show is an
  // operational and email-suppression signal, not a conversion correction.
  utcNoShowReportedAt  DateTime?
  noShowReason         String?
  utcNoShowConfirmedAt DateTime?

  // B6 queued-job idempotency guards (EVENT-DRIVEN-AND-QUEUES.md §5.1): each
  // consumer checks-then-stamps its own column, so a redelivered job never
  // double-sends. CAPI needs no column - Meta dedups by event id (publicRef).
  utcConfirmationEmailSentAt DateTime?
  utcOperatorNoticeSentAt    DateTime?
  utcReminderSentAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tour             Tour              @relation(fields: [tourId], references: [id])
  departure        Departure?        @relation(fields: [departureId], references: [id])
  operator         Operator          @relation(fields: [operatorId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])
  pickupLocation   PickupLocation?   @relation(fields: [pickupLocationId], references: [id])
  unitItems        BookingUnitItem[]
  addOns           BookingAddOn[]
  payments         Payment[]
  review           Review?
  reviewInvitation ReviewInvitation?
  settlement       Settlement?
  conversionEvents ConversionEvent[]

  @@index([tourId])
  @@index([operatorId])
  @@index([userId])
  @@index([status])
  // MK-1 dueness band (tourEndDateTime BETWEEN horizon AND cutoff) - the
  // selective predicate of the marketing candidate query.
  @@index([tourEndDateTime])
  @@index([departureId])
  @@index([localDate])
  @@map("bookings")
}

// ── Settlement ledger (master SETTLEMENT-AND-PAYOUTS §2) ──────────────────────
// The OPERATOR-PAYOUT ledger: one row per confirmed PAID_IN_FULL booking (the only
// model where Island Tours holds money it owes the operator), written at
// confirmation, all amounts in EUR. Self-settling deposit models never get a row
// (founder decision 2026-07-26 - noise-free ledger). Payout is MANUAL in v1:
// PAID_OUT is only ever set by an admin's "Mark as paid" after the bank transfer,
// never by a cron. The extension hooks below let v2 grow into scheduled Connect
// payouts + operator_full invoicing WITHOUT a data-model rewrite.
model Settlement {
  id           String       @id @default(uuid())
  bookingId    String       @unique
  booking      Booking      @relation(fields: [bookingId], references: [id])
  operatorId   String
  paymentModel PaymentModel

  // Core ledger (locked minimum), EUR.
  amountCollected Decimal @db.Decimal(10, 2) // what IT collected at checkout
  commissionOwed  Decimal @db.Decimal(10, 2) // IT's commission
  netPosition     Decimal @db.Decimal(10, 2) // + = IT owes operator; - = operator owes IT

  // Extension hooks (nullable in v1; used by v2 payouts / Connect / invoicing).
  currency       Currency         @default(EUR)
  operatorPayout Decimal?         @db.Decimal(10, 2) // amount paid out (paid_in_full, B4)
  status         SettlementStatus @default(RECORDED)
  settledAt      DateTime?
  externalRef    String? // Stripe transfer/payout id or invoice id (v2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId, status])
  @@index([status])
  @@map("settlements")
}

// One per traveler/ticket, priced at the age band it was sold at.
model BookingUnitItem {
  id        String  @id @default(uuid())
  uuid      String  @unique @default(uuid())
  bookingId String
  ageBandId String? // null for UNIT-priced tours (no age bands — the item is a guest seat on the whole unit)

  status        BookingStatus @default(ON_HOLD)
  utcRedeemedAt DateTime?

  // Per-traveler contact (optional; OCTO allows per-unit contact)
  contactFirstName String?
  contactLastName  String?
  travelerAge      Int? // child ages (master "children_count plus child ages"); min-age enforcement

  // Pricing snapshot
  priceRetail Decimal  @db.Decimal(10, 2)
  priceNet    Decimal? @db.Decimal(10, 2)

  // Ticket (OCTO Ticket delivery artifact)
  ticketCode           String?
  ticketDeliveryFormat DeliveryFormat?
  ticketUrl            String?

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ageBand TourAgeBand? @relation(fields: [ageBandId], references: [id])

  @@index([bookingId])
  @@map("booking_unit_items")
}

// Selected add-on line item — snapshotted at booking time so a later edit/delete of
// the TourAddOn never mutates a placed booking. addOnId is a soft reference for reporting.
model BookingAddOn {
  id        String  @id @default(uuid())
  bookingId String
  addOnId   String? // soft ref to TourAddOn; the snapshot below is the source of truth

  name       String // snapshot of TourAddOn.name
  unit       AddOnUnit @default(PER_PERSON) // snapshot (PER_PERSON | FLAT)
  quantity   Int       @default(1)
  unitPrice  Decimal   @db.Decimal(10, 2) // snapshot of TourAddOn.price
  totalPrice Decimal   @db.Decimal(10, 2) // computed at booking time (unitPrice × qty × pax if PER_PERSON)

  booking Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOn   TourAddOn? @relation(fields: [addOnId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("booking_addons")
}

// One-time login code for the traveller account area (/{locale}/traveller).
// The code itself is never stored - only an HMAC keyed by TRAVELER_SESSION_SECRET,
// so a DB dump alone cannot forge a login. Rows are single-use (consumedAt) and
// expire 10 minutes after creation; request-code opportunistically deletes rows
// expired for more than 24h, so no cleanup job is needed.
model TravelerLoginCode {
  id         String    @id @default(uuid())
  email      String // stored lowercased
  codeHash   String // HMAC-SHA256(TRAVELER_SESSION_SECRET, `${email}:${code}`), hex
  expiresAt  DateTime // createdAt + 10 min
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@map("traveler_login_codes")
}
