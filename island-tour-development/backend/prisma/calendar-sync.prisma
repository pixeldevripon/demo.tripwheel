// Calendar IMPORT (inbound iCal) — the operator subscribes an external calendar
// (Airbnb, Booking.com, GetYourGuide, a personal Google calendar) and we poll it
// and stop-sell the dates it marks busy.
//
// ── THE GUARDRAIL ────────────────────────────────────────────────────────────
// `departures` is the single source of truth (spec non-negotiable 1: "not iCal,
// not a cache, not the operator's external calendar"). An imported event NEVER
// becomes a booking, NEVER changes capacity and NEVER writes a departure row.
// It becomes an `AvailabilityException` (CLOSE_DATE / CLOSE_SLOT) and the
// existing materializer projects it. That is why there is no `blocked_dates`
// table here even though the PRD proposes one — it would be a second
// availability layer beside departures. See
// technical-doc/02-architecture/ICAL-PRD-GAP-ANALYSIS.md §1.

/// Known channels, for the picker, the per-platform "where do I find my link"
/// help, and per-host rate limiting. `OTHER` carries a free-text label.
enum CalendarPlatform {
  AIRBNB          @map("airbnb")
  BOOKING_COM     @map("booking_com")
  EXPEDIA         @map("expedia")
  VRBO            @map("vrbo")
  VIATOR          @map("viator")
  GETYOURGUIDE    @map("getyourguide")
  MAKEMYTRIP      @map("makemytrip")
  GOOGLE_CALENDAR @map("google_calendar")
  OTHER           @map("other")

  @@map("calendar_platform")
}

/// What a busy block from this feed actually does to our inventory. Operator
/// choice per connection, because the right answer depends on the tour.
///
/// iCal carries NO seat count — an external "Busy" event says the whole listing
/// is unavailable, not that one seat sold. On a 60-seat catamaran, closing the
/// day because Airbnb sold one seat is simply wrong, which is why WARN_ONLY is
/// the default rather than CLOSE_DATES.
enum CalendarImportMode {
  /// Close the whole date. Right for single-departure-per-day, whole-boat charters.
  CLOSE_DATES @map("close_dates")
  /// Close only departures whose [start, start+duration) overlaps the busy block.
  CLOSE_SLOTS @map("close_slots")
  /// Write nothing. Record the conflict and notify. Right for multi-capacity tours.
  WARN_ONLY   @map("warn_only")
  /// Dry run: keep fetching and logging what WOULD be blocked, write nothing.
  /// Distinct from PAUSED, which stops fetching altogether.
  IGNORE      @map("ignore")

  @@map("calendar_import_mode")
}

enum CalendarSubscriptionStatus {
  /// Created, first sync not finished yet.
  PENDING      @map("pending")
  SYNCING      @map("syncing")
  ACTIVE       @map("active")
  /// Transient failures exhausted the retry budget. Existing blocks are RETAINED.
  ERROR        @map("error")
  /// Permanent: 401/403/404/410, wrong content type, unparseable.
  INVALID_URL  @map("invalid_url")
  /// Operator switched auto-sync off. No fetching at all.
  PAUSED       @map("paused")
  /// Soft-deleted. Kept so sync history and the audit trail survive.
  DISCONNECTED @map("disconnected")

  @@map("calendar_subscription_status")
}

enum IcalSyncTrigger {
  SCHEDULED  @map("scheduled")
  MANUAL     @map("manual")
  ON_CONNECT @map("on_connect")
  RETRY      @map("retry")
  ADMIN      @map("admin")

  @@map("ical_sync_trigger")
}

enum IcalSyncOutcome {
  SUCCESS   @map("success")
  /// Some events were skipped (caps, unparseable individual VEVENTs) but the run applied.
  PARTIAL   @map("partial")
  FAILED    @map("failed")
  /// 304, or the content hash matched — nothing to do.
  UNCHANGED @map("unchanged")
  /// IGNORE mode, or the validate endpoint: parsed and logged, wrote nothing.
  DRY_RUN   @map("dry_run")

  @@map("ical_sync_outcome")
}

/// What we did about a busy block that landed on a departure with bookings.
enum CalendarConflictResolution {
  /// WARN_ONLY: departure left open, operator told.
  KEPT_OPEN @map("kept_open")
  /// CLOSE_DATES / CLOSE_SLOTS: stop-sell applied. Existing bookings stay valid.
  BLOCKED   @map("blocked")

  @@map("calendar_conflict_resolution")
}

/// One external calendar attached to one tour.
///
/// PER TOUR, not per operator: Airbnb hands out one iCal link per listing, and a
/// busy block only means "this tour is unavailable". An operator-wide connection
/// would close every tour whenever any one of them is busy.
model CalendarSubscription {
  id     String @id @default(uuid())
  tourId String

  platform      CalendarPlatform
  /// Free-text channel name. Required when platform = OTHER, ignored otherwise.
  platformLabel String?

  /// AES-256-GCM ciphertext (see common/utils/crypto.util.ts), NEVER plaintext.
  /// An OTA iCal URL is a BEARER CREDENTIAL for the operator's account on that
  /// platform - anyone holding it can read that account's calendar. It is
  /// decrypted only inside the fetcher and masked everywhere it is displayed.
  url     String
  /// SHA-256 of the NORMALIZED url. Duplicate detection and lookup without
  /// decrypting every row (ciphertext is non-deterministic - the IV is random -
  /// so `url` itself can never be compared or indexed for equality).
  urlHash String

  /// Defaults to WARN_ONLY, not CLOSE_DATES: every tour on this platform is
  /// multi-capacity, and one external booking must not close a 60-seat boat.
  importMode      CalendarImportMode         @default(WARN_ONLY)
  status          CalendarSubscriptionStatus @default(PENDING)
  autoSyncEnabled Boolean                    @default(true)

  /// Poll cadence. The scheduler is the authority on when a poll actually runs.
  syncIntervalMinutes Int @default(60)

  // ── Poll state ──────────────────────────────────────────────────────────────
  nextPollAt    DateTime? // null when paused or disconnected
  lastPolledAt  DateTime? // last ATTEMPT, successful or not
  lastSuccessAt DateTime? // drives the "stale" computation in the UI

  /// Conditional-GET state, echoed back as If-None-Match / If-Modified-Since so
  /// an unchanged feed costs a 304 instead of a full download and re-parse.
  lastEtag         String?
  lastModified     String?
  /// SHA-256 of the normalized event set. A 200 whose content hash is unchanged
  /// short-circuits the diff entirely (some feeds never send ETags).
  lastContentHash  String?
  lastErrorCode    String? // machine readable, e.g. HTTP_404, FEED_TIMEOUT
  lastErrorMessage String? // human readable, shown in the UI
  failureCount     Int     @default(0) // consecutive; drives the retry ladder
  lastEventCount   Int     @default(0)

  /// Loop breaker: when a channel echoes our own export back at us, exclude this
  /// connection's blocks from the outbound feed so they cannot ping-pong.
  excludeFromExport Boolean @default(false)

  notes     String?
  createdBy String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// Soft delete. The row is kept so history and the audit trail survive.
  disconnectedAt DateTime?

  tour      Tour                    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  events    CalendarEvent[]
  syncLogs  IcalSyncLog[]
  conflicts CalendarConflict[]
  blocks    AvailabilityException[]

  /// One connection per URL per tour. A DISCONNECTED row still holds its slot -
  /// re-adding the same URL revives that row rather than creating a second, so
  /// its history stays attached (mirrors how CalendarFeed revival works).
  @@unique([tourId, urlHash])
  @@index([nextPollAt])
  @@index([tourId, status])
  @@map("calendar_subscriptions")
}

/// The parsed state of the last successful sync: the diff baseline.
///
/// Without it we cannot tell "this event is gone from the feed" (release its
/// block) from "we have never seen this event" - and releasing the wrong dates
/// is how an operator gets double-booked.
model CalendarEvent {
  id             String @id @default(uuid())
  subscriptionId String

  /// The feed's own UID, or a deterministic hash of start+end+summary when the
  /// feed omits one (some do).
  externalUid String
  summary     String?

  /// `endDate` is EXCLUSIVE, matching iCal: 01→05 covers the 1st to the 4th.
  /// Stored verbatim as the feed expresses it; the exclusive→inclusive
  /// conversion happens when mapping to exceptions, once, in one place.
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  startTime DateTime? @db.Time(0)
  endTime   DateTime? @db.Time(0)
  isAllDay  Boolean   @default(true)

  /// From TZID or the calendar-level X-WR-TIMEZONE. Null = floating; the tour's
  /// own timezone is the fallback.
  sourceTimeZone String?

  /// Raw RRULE kept for audit. Expansion happens at parse time, capped.
  recurrenceRule       String?
  isRecurrenceInstance Boolean @default(false)

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime
  /// Tombstone: present in an earlier sync, absent now.
  removedAt   DateTime?

  subscription CalendarSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// startDate is in the key because channels reuse a UID across recurring or
  /// amended reservations (PRD §9.4).
  @@unique([subscriptionId, externalUid, startDate])
  @@index([subscriptionId, lastSeenAt])
  @@map("calendar_events")
}

/// One row per sync attempt. The spec's `ical_sync_logs`.
///
/// This is a USER-FACING surface, not just a debug table: it is how an operator
/// answers "why did my dates change" and "why has nothing synced since Tuesday",
/// the audit trail when an import closed a booked date, and - in WARN_ONLY mode,
/// where nothing is written to availability - most of the feature's output.
model IcalSyncLog {
  id             String @id @default(uuid())
  subscriptionId String
  tourId         String // denormalized so the per-tour history reads one table

  trigger     IcalSyncTrigger
  triggeredBy String? // null for scheduled runs
  outcome     IcalSyncOutcome
  httpStatus  Int?

  eventsFound       Int @default(0)
  eventsAdded       Int @default(0)
  eventsRemoved     Int @default(0)
  /// The delta an operator actually cares about: what changed in availability.
  blocksCreated     Int @default(0)
  blocksRemoved     Int @default(0)
  conflictsDetected Int @default(0)

  errorCode         String?
  errorMessage      String?
  responseSizeBytes Int?

  durationMs Int
  startedAt  DateTime
  finishedAt DateTime

  subscription CalendarSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, startedAt])
  @@index([tourId, startedAt])
  @@map("ical_sync_logs")
}

/// An imported busy block landed on a departure that already has bookings.
///
/// A first-class row rather than only a notification: the operator has to be
/// able to come back to it, and an unacknowledged conflict is the one signal
/// that a real double-sale happened on another channel.
model CalendarConflict {
  id             String  @id @default(uuid())
  subscriptionId String
  tourId         String
  /// Null if the departure was later removed; the date/time below still identify it.
  departureId    String?

  conflictDate DateTime  @db.Date
  startTime    DateTime? @db.Time(0) // null = the whole date was involved
  /// Snapshot at detection time - the numbers that made this a conflict.
  bookedCount  Int
  capacity     Int

  resolution     CalendarConflictResolution
  acknowledgedAt DateTime?
  acknowledgedBy String?

  createdAt DateTime @default(now())

  subscription CalendarSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  departure    Departure?           @relation(fields: [departureId], references: [id], onDelete: SetNull)

  @@index([tourId, acknowledgedAt])
  @@index([subscriptionId, createdAt])
  @@map("calendar_conflicts")
}
