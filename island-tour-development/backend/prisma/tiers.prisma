// Commercial engine — Destination Spotlight request/approval.
// Tier columns (commissionTier / tierKey / tierRank / quality / eligibility) live on Tour.
// TierKey → commissionTier/tierRank mapping + 30-day lock is enforced in the service.
// Quality-score + eligibility are nightly BullMQ jobs.

model SpotlightRequest {
  id            String @id @default(uuid())
  tourId        String
  operatorId    String
  destinationId String

  status      SpotlightStatus @default(REQUESTED)
  requestedAt DateTime        @default(now())
  approvedAt  DateTime?
  approvedBy  String? // admin user id
  startsAt    DateTime?
  endsAt      DateTime?
  note        String?

  tour        Tour        @relation(fields: [tourId], references: [id], onDelete: Cascade)
  operator    Operator    @relation(fields: [operatorId], references: [id])
  destination Destination @relation(fields: [destinationId], references: [id])

  @@index([destinationId, status]) // enforce max 3 active per destination in service
  @@index([tourId])
  @@map("spotlight_requests")
}

// Force-majeure pardon (master COMMERCIAL §6) — an admin marks a date range + destination
// (e.g. a hurricane day). Operator cancellations inside a pardoned range are excluded from the
// cancellation-rate eligibility metric for EVERY operator at once.
model ForceMajeurePardon {
  id            String   @id @default(uuid())
  destinationId String
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  reason        String
  createdBy     String // admin user id
  createdAt     DateTime @default(now())

  destination Destination @relation(fields: [destinationId], references: [id])

  @@index([destinationId, startDate, endDate])
  @@map("force_majeure_pardons")
}
