// Featured Slots domain — the slot economy.
//
// CRITICAL RULES:
//   #7  — Never DELETE FeaturedSlot rows. Only UPDATE.
//   #8  — Publish uses conditional updateMany WHERE status='SOFT_LOCKED' (race guard).
//   #10 — Store bullJobId on SlotLock; store offerJobId on WaitlistEntry (waitlist.prisma).
//
// Each Category always has exactly 3 FeaturedSlot rows (seeded on category create).
// Slot tiers: slot 1 = 22% commission, slot 2 = 25%, slot 3 = 30%.

model FeaturedSlot {
  id             String     @id @default(uuid())
  categoryId     String
  slotNumber     Int        // 1 | 2 | 3
  status         SlotStatus @default(AVAILABLE)

  // Set when SOFT_LOCKED or HARD_RESERVED
  tripId         String?    @unique
  operatorId     String?
  acquiredAt     DateTime?
  expiresAt      DateTime?  // 90-day cap end date when HARD_RESERVED
  commissionRate Float?     // 0.22 | 0.25 | 0.30 — set at lock time

  category    Category       @relation(fields: [categoryId], references: [id])
  trip        Trip?          @relation(fields: [tripId], references: [id])
  operator    Operator?      @relation(fields: [operatorId], references: [id])
  slotLocks   SlotLock[]
  history     SlotHistory[]
  waitlist    WaitlistEntry[]

  @@unique([categoryId, slotNumber])
  @@index([categoryId, status])
  @@map("featured_slots")
}

// Active 15-minute soft-lock. Deleted on publish or TTL expiry.
// bullJobId is the BullMQ job ID for the 'release-lock' delayed job —
// must be stored so the job can be cancelled when operator publishes early.
model SlotLock {
  id         String   @id @default(uuid())
  slotId     String
  operatorId String
  tripId     String   @unique
  expiresAt  DateTime
  bullJobId  String   // BullMQ job ID — cancel this when publishing

  createdAt  DateTime @default(now())

  slot     FeaturedSlot @relation(fields: [slotId], references: [id])
  operator Operator     @relation(fields: [operatorId], references: [id])
  trip     Trip         @relation(fields: [tripId], references: [id])

  @@index([slotId])
  @@index([expiresAt])
  @@map("slot_locks")
}

// Immutable audit trail for every slot status transition.
model SlotHistory {
  id         String      @id @default(uuid())
  slotId     String
  fromStatus SlotStatus?
  toStatus   SlotStatus
  operatorId String?
  tripId     String?
  note       String?

  createdAt  DateTime @default(now())

  slot FeaturedSlot @relation(fields: [slotId], references: [id])

  @@index([slotId])
  @@map("slot_history")
}
