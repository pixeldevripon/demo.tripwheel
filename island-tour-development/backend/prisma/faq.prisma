// FAQ — admin-managed FAQ items for any entity page.
// Uses a pageType discriminator (polymorphic association) instead of per-entity
// tables because the FAQ structure is identical across all entity types:
// question + answer + displayOrder + locale + isActive.
// The service layer enforces that entityId belongs to the correct pageType.
model Faq {
  id           String      @id @default(uuid())
  pageType     FaqPageType
  entityId     String // UUID of the owning entity
  // Links the per-locale rows of a single logical FAQ. All locale variants of the
  // same question/answer share one faqGroupId (the English row is the base). NULL on
  // legacy rows created before grouping existed — those are treated as one-locale groups.
  faqGroupId   String?
  locale       Locale
  question     String
  answer       String
  displayOrder Int         @default(0)
  isActive     Boolean     @default(true)

  // One row per locale within a group. faqGroupId is nullable, and Postgres treats
  // NULLs as distinct, so legacy ungrouped rows never collide.
  @@unique([pageType, entityId, faqGroupId, locale])
  @@index([pageType, entityId, locale])
  @@map("faqs")
}
