model Operator {
  id                 String                     @id @default(uuid())
  userId             String                     @unique // linked to auth User
  isActive           Boolean                    @default(true)
  verificationStatus OperatorVerificationStatus @default(UNVERIFIED)

  // Onboarding state machine (EMAIL-IMPLEMENTATION-PLAN §2.4). The wireframe's
  // created → accepted → approved maps onto verificationStatus (accepted =
  // PENDING, approved = VERIFIED); these timestamps anchor the email sequence.
  verificationDecidedAt  DateTime? // stamped by approve/reject — the OB-3/4/6 anchor
  firstTourLiveAt        DateTime? // stamped once by the first tour publish — the OB-7/8 anchor
  salesPendingReminderAt DateTime? // INT1R guard: set when the 2-business-day reminder fires

  // Which PSP this operator charges through (mirrors the platform's
  // payment_settings.activeProvider; switch guarded on configured credentials)
  activePaymentProvider PaymentProvider @default(STRIPE)

  // Cached review aggregates (updated on review approve — see LD11 in CLAUDE.md)
  aggregateRating      Float?
  aggregateReviewCount Int       @default(0)
  aggregatesUpdatedAt  DateTime?

  // OCTO supplier contact (E.164 phone)
  contactEmail String?
  contactPhone String?

  // Eligibility engine (master)
  cancellationRate90d Decimal @default(0) @db.Decimal(5, 2) // % over trailing 90d
  totalBookings       Int     @default(0)
  forceMajeurePardons Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations — auth
  user User @relation(fields: [userId], references: [id])

  // Relations — business
  companyInfo  OperatorCompanyInfo?
  socialMedia  OperatorSocialMedia?
  stripeConfig OperatorStripeConfig?
  mollieConfig OperatorMollieConfig?

  // Relations — team (staff.prisma)
  staffMembers      StaffMember[]
  staffDesignations StaffDesignation[]

  // Relations — platform
  tours                     Tour[]
  bookings                  Booking[]
  reviews                   Review[]
  customers                 Customer[]
  spotlightRequests         SpotlightRequest[]
  notificationSubscriptions NotificationSubscription[]
  calendarFeeds             CalendarFeed[]
  inboxNotifications        InboxNotification[]

  @@index([verificationStatus])
  @@map("operators")
}

model OperatorCompanyInfo {
  id         String @id @default(cuid())
  operatorId String @unique

  // Business identity
  companyName    String?
  companyEmail   String?
  companyCountry String?
  companyCity    String?
  companyPhone   String?

  // Business intent
  plannedTripCount  Int?
  yearlySalesTarget Int?

  operator  Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("operator_company_info")
}

model OperatorSocialMedia {
  id           String  @id @default(cuid())
  operatorId   String  @unique
  facebookUrl  String? @default("")
  instagramUrl String? @default("")
  twitterUrl   String? @default("")
  linkedinUrl  String? @default("")

  operator  Operator @relation(fields: [operatorId], references: [id])
  updatedAt DateTime @updatedAt

  @@map("operator_social_media")
}

model OperatorStripeConfig {
  id             String   @id @default(cuid())
  operatorId     String   @unique
  publishableKey String   @default("")
  secretKey      String   @default("")
  webhookSecret  String   @default("")
  paymentMethods String[] @default([])
  isActive       Boolean  @default(false)

  operator  Operator @relation(fields: [operatorId], references: [id])
  updatedAt DateTime @updatedAt

  @@map("operator_stripe_config")
}

model OperatorMollieConfig {
  id             String   @id @default(cuid())
  operatorId     String   @unique
  apiKey         String   @default("")
  paymentMethods String[] @default([])
  isActive       Boolean  @default(false)

  operator  Operator @relation(fields: [operatorId], references: [id])
  updatedAt DateTime @updatedAt

  @@map("operator_mollie_config")
}
