// Destinations domain — Caribbean islands + Activity Hubs
// Admin-only create. Operators cannot create destinations or hubs.
// Critical Rule #21–#23: slug_registry rows written in same transaction as entity create.

model Destination {
  id           String  @id @default(uuid())
  name         String
  slug         String  @unique // 'curacao', 'aruba' — always English
  heroImage    String?
  isSeeded     Boolean @default(false) // true = seeded at launch; guard delete in service
  isActive     Boolean @default(true)
  // Curated platform order for every island list (hero Popular row, Explore
  // islands, selectors): 1 = launch island leads. null = unranked → sorts
  // after ranked rows, alphabetical. Never alphabetical-first: the locked copy
  // is "Popular: Curaçao · Aruba · Sint Maarten".
  displayOrder Int?
  createdBy    String? // null = seeded; userId = admin who created

  // ── V2 fields ────────────────────────────────────────────────────────────────
  region              Region // geographic grouping (no URL layer) — V2 §2 (required)
  country             String?
  latitude            Float?
  longitude           Float?
  timezone            String? // IANA timezone, e.g. 'America/Curacao'
  currency            Currency? // default currency (ISO 4217 enum)
  language            String? // primary language code
  galleryImages       String[]      @default([])
  ogImage             String? // Open Graph image
  // Future sub-destinations (V2 §2) — nullable, unused at launch.
  parentDestinationId String?
  parentDestination   Destination?  @relation("DestinationParent", fields: [parentDestinationId], references: [id])
  subDestinations     Destination[] @relation("DestinationParent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator                 User?                    @relation("DestinationCreator", fields: [createdBy], references: [id])
  hubs                    Hub[]
  tours                   Tour[]
  collections             Collection[]
  translations            DestinationTranslation[]
  pageContents            DestinationPageContent[]
  spotlightRequests       SpotlightRequest[]
  forceMajeurePardons     ForceMajeurePardon[]
  // Back-relation for the homepage editorial CTA target (onDelete: SetNull).
  homePages               HomePage[]
  // Instagram tiles pinned to this destination (onDelete: Cascade). Brand-wide
  // tiles carry a null destinationId and are not in this relation.
  instagramPosts          InstagramPost[]
  destinationPopularLinks DestinationPopularLink[]

  @@index([slug])
  @@index([isActive])
  @@index([region])
  @@index([parentDestinationId])
  @@map("destinations")
}

// Per-locale translations for a destination.
// Destination names are proper nouns (Curaçao, Aruba) — never AI-translated.
// Admin sets manually. isMachineTranslated should always be false for destinations.
model DestinationTranslation {
  id                  String      @id @default(uuid())
  destinationId       String
  destination         Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  locale              Locale
  name                String? // localized display name; null falls back to Destination.name
  overview            String?
  h1Override          String?
  breadcrumbLabel     String?
  isMachineTranslated Boolean     @default(false)
  sourceHash          String? // sha1 of the EN source a machine row was built from
  updatedAt           DateTime    @updatedAt

  @@unique([destinationId, locale])
  @@index([destinationId, locale])
  @@map("destination_translations")
}

// Per-locale editorial page content for a destination (about text, SEO metadata).
model DestinationPageContent {
  id              String      @id @default(uuid())
  destinationId   String
  destination     Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  locale          Locale
  aboutText       String?
  metaTitle       String?
  metaDescription String?

  // AI translation bookkeeping (same contract as the *Translation tables).
  isMachineTranslated Boolean @default(false)
  sourceHash          String?

  @@unique([destinationId, locale])
  @@index([destinationId, locale])
  @@map("destination_page_content")
}

// Activity Hubs — destination-specific special locations (e.g. Klein Curaçao)
// Admin-only create. Destination is mandatory.
model Hub {
  id            String    @id @default(uuid())
  destinationId String
  name          String
  slug          String // locale-independent English slug; unique per destination
  description   String? // master E.4 short_description (card/meta blurb)
  heroImage     String? // full-bleed hero — the hub's defining element (HUB-DATA.md G1)
  ogImage       String? // Open Graph image (E.4)
  // ── V2 fields (Stage 1) ──────────────────────────────────────────────────────
  // `hubType` nullable in Stage 1; backfilled in Stage 2.
  hubType       HubType? // location | highlight | area — V2 §5
  status        HubStatus @default(DRAFT) // publish lifecycle (G6)
  latitude      Float? // for location-type hubs
  longitude     Float?
  isSeeded      Boolean   @default(false) // true = seeded at launch; guard delete in service
  isActive      Boolean   @default(true)
  createdBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destination            Destination              @relation(fields: [destinationId], references: [id])
  creator                User?                    @relation("HubCreator", fields: [createdBy], references: [id])
  allowedCategories      HubAllowedCategory[]
  ourPicks               HubOurPick[]
  comparisonGroups       HubComparisonGroup[]
  contentSections        HubContentSection[] // Discover / Local Tips / Fast Facts / Editorial
  translations           HubTranslation[]
  pageContents           HubPageContent[]
  tourHubs               TourHub[]
  // Homepage editorial CTA cards advertising this hub (onDelete: SetNull -
  // deleting the hub degrades the card to a plain photo, never deletes it).
  homePageEditorialCards HomePageEditorialCard[]
  popularLinks           DestinationPopularLink[]

  @@unique([destinationId, slug])
  @@index([destinationId])
  @@map("hubs")
}

// Per-locale translations for a hub.
// Hub names are proper nouns (Klein Curaçao) — never AI-translated. Admin sets manually.
model HubTranslation {
  id                  String   @id @default(uuid())
  hubId               String
  hub                 Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  locale              Locale
  name                String? // null falls back to Hub.name
  overview            String? // editorial lead ("Why {hub}", ≤150 words, no visible header)
  heroTagline         String? // hero subtitle under H1 ("Where islanders send their visitors") — G5
  h1Override          String?
  breadcrumbLabel     String?
  isMachineTranslated Boolean  @default(false)
  sourceHash          String? // sha1 of the EN source a machine row was built from
  updatedAt           DateTime @updatedAt

  @@unique([hubId, locale])
  @@index([hubId, locale])
  @@map("hub_translations")
}

// Per-locale editorial page content for a hub (about text, SEO metadata).
model HubPageContent {
  id              String  @id @default(uuid())
  hubId           String
  hub             Hub     @relation(fields: [hubId], references: [id], onDelete: Cascade)
  locale          Locale
  aboutText       String?
  metaTitle       String?
  metaDescription String?

  // AI translation bookkeeping (same contract as the *Translation tables).
  isMachineTranslated Boolean @default(false)
  sourceHash          String?

  @@unique([hubId, locale])
  @@index([hubId, locale])
  @@map("hub_page_content")
}

// Defines which categories of tours may be assigned to a hub.
// Operator tour creation checks this before showing the hub selector.
model HubAllowedCategory {
  id         String @id @default(uuid())
  hubId      String
  categoryId String

  hub      Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([hubId, categoryId])
  @@map("hub_allowed_categories")
}

// Admin editorial "Our Pick" selections for a hub page tab.
model HubOurPick {
  id           String      @id @default(uuid())
  hubId        String
  tourId       String
  pickType     HubPickType
  description  String // base-locale editorial blurb (fallback)
  displayOrder Int         @default(0)

  hub          Hub                     @relation(fields: [hubId], references: [id], onDelete: Cascade)
  tour         Tour                    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  translations HubOurPickTranslation[]

  @@unique([hubId, tourId])
  @@map("hub_our_picks")
}

// Per-locale Our-Pick blurb (G8).
model HubOurPickTranslation {
  id          String     @id @default(uuid())
  ourPickId   String
  locale      Locale
  description String
  ourPick     HubOurPick @relation(fields: [ourPickId], references: [id], onDelete: Cascade)

  // AI translation bookkeeping (same contract as the *Translation tables).
  isMachineTranslated Boolean @default(false)
  sourceHash          String?

  @@unique([ourPickId, locale])
  @@map("hub_our_pick_translations")
}

// Comparison groups for the hub's "Compare" tab (e.g. "Comfort trips" vs "Adventure trips").
model HubComparisonGroup {
  id           String @id @default(uuid())
  hubId        String
  groupName    String // base-locale label (fallback)
  displayOrder Int    @default(0)

  hub             Hub                             @relation(fields: [hubId], references: [id], onDelete: Cascade)
  comparisonTours HubComparisonTour[]
  translations    HubComparisonGroupTranslation[]

  @@map("hub_comparison_groups")
}

// Per-locale comparison group name (G3).
model HubComparisonGroupTranslation {
  id        String             @id @default(uuid())
  groupId   String
  locale    Locale
  groupName String
  group     HubComparisonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // AI translation bookkeeping (same contract as the *Translation tables).
  isMachineTranslated Boolean @default(false)
  sourceHash          String?

  @@unique([groupId, locale])
  @@map("hub_comparison_group_translations")
}

model HubComparisonTour {
  id           String  @id @default(uuid())
  groupId      String
  tourId       String
  standoutNote String? // base-locale "what stands out" cell (curated; G3)
  displayOrder Int     @default(0)

  group        HubComparisonGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tour         Tour                           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  translations HubComparisonTourTranslation[]

  @@unique([groupId, tourId])
  @@map("hub_comparison_tours")
}

// Per-locale "what stands out" comparison cell (G3).
model HubComparisonTourTranslation {
  id               String            @id @default(uuid())
  comparisonTourId String
  locale           Locale
  standoutNote     String
  comparisonTour   HubComparisonTour @relation(fields: [comparisonTourId], references: [id], onDelete: Cascade)

  // AI translation bookkeeping (same contract as the *Translation tables).
  isMachineTranslated Boolean @default(false)
  sourceHash          String?

  @@unique([comparisonTourId, locale])
  @@map("hub_comparison_tour_translations")
}

// Hub editorial content blocks (HUB-DATA.md §5): Discover deep-dive subsections, Local
// Tips, the hero Fast Facts bar, and extra editorial blocks. Titled, ordered, per-locale.
model HubContentSection {
  id           String         @id @default(uuid())
  hubId        String
  locale       Locale
  sectionType  HubSectionType
  heading      String
  body         String
  image        String?
  displayOrder Int            @default(0)

  // AI translation bookkeeping. Locale rows have no FK group key; the logical
  // identity of a block across locales is (sectionType, displayOrder) - the
  // same convention the dashboard editor groups by.
  isMachineTranslated Boolean @default(false)
  sourceHash          String?

  hub Hub @relation(fields: [hubId], references: [id], onDelete: Cascade)

  // The AI-translation unit key depends on this identity being unique - the
  // dashboard's save already regenerates displayOrder per type, this makes
  // the DB enforce what the design assumes.
  @@unique([hubId, locale, sectionType, displayOrder])
  @@index([hubId, locale, sectionType, displayOrder])
  @@map("hub_content_sections")
}

// "Top Island Experiences" section — categories and hubs only, never individual tours.
// Admin manually curates + attaches video clips.
//
// TITLE AND IMAGE ARE NOT STORED HERE. They are read from the referenced Category
// or Hub at resolve time, so the card inherits that entity's translations for free
// and can never drift from the page it links to.
//
// `entityId` HAS NO FOREIGN KEY, and cannot have one: it points at either a
// Category or a Hub depending on `entityType`, and a relational FK targets exactly
// one table. The consequences are handled deliberately rather than pretended away:
//   - the resolver skips any row it cannot resolve, so an orphan is inert (it can
//     never render as a dead link);
//   - the only hard-delete path (`categories.forceDelete`) clears its rows in the
//     same transaction;
//   - soft-deactivation needs no cleanup - the resolver's isActive gate covers it.
// The same polymorphic-without-FK shape is used by `Faq` (pageType + entityId).
// "Top island experiences" homepage reel cards. PURELY PRESENTATIONAL
// (founder, 2026-08-04): a card is an admin-typed label + poster + optional
// video. No category/hub reference, no destination scoping, no link - the
// reel is a mood board of the platform's activities, not navigation. The
// label is a single admin-entered string, not translated across locales.
model FeaturedExperience {
  id           String  @id @default(uuid())
  title        String
  videoUrl     String?
  // Card poster; doubles as the <video> poster so a card with a video never
  // flashes black before it plays. The carousel slot is a 250x440 PORTRAIT
  // crop. A card with no poster is dropped by the public resolver (a grey
  // rectangle is not a card).
  posterUrl    String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  @@map("featured_experiences")
}

// Admin-curated quick links into an island's own pages, in two placements
// (`placement`): the "Popular" line under the hero search (mck-02: "Popular:
// Klein Curaçao · Best Things to Do in Curaçao · Off-Road Tours · Boat Tours &
// Cruises"), and the search field's zero-state panel (master 5.10). Each list is
// capped in the service (POPULAR_LINK_MAX) and ordered independently.
//
// Each link is a page in THIS island's flat `/{destination}/{slug}` namespace -
// a hub, a collection or a category - so one row shape covers all three, the
// same polymorphic-with-FKs shape HomePageEditorialCard uses.
//
// Curation, not ranking, because "Popular" is an editorial claim and no rule
// over live data reproduces the founder's four: Off-Road Tours is fifth by
// sortOrder and joint-fourth by tour count, so it fell outside a row of four
// however the row was sorted. Confirmed by the founder ("no dynamic order
// matters here").
//
// Curation picks WHICH pages; it never asserts that one exists. Every link is
// re-gated at render against the target's own visibility rule (a category needs
// CATEGORY_PAGE_MIN_TOURS live tours here, a hub must be published with a live
// tour, a collection must be published) and is silently dropped otherwise -
// the founder's standing condition, "these must show when these collections and
// categories have data to render page".
//
// No rows = fall back to the automatic composition (hub, lead collection, then
// categories), so an island nobody has curated still gets a Popular row.
//
// Cascade, not SetNull: a link whose target is gone has nothing to degrade to,
// unlike an editorial CARD, which keeps its photo.
model DestinationPopularLink {
  id            String      @id @default(uuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  // Which surface this row belongs to. Two independent ordered lists over one
  // table: the hero's "Popular" line and the search field's zero-state panel
  // both curate the same three page types, so they share the resolver, the
  // re-gating and the replace-all save rather than each growing its own.
  placement PopularLinkPlacement @default(HERO_POPULAR)

  // Exactly one of the three is set - the service rejects none and rejects more
  // than one, so a row always names exactly one page.
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  hubId        String?
  hub          Hub?        @relation(fields: [hubId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  // Zero-based, left to right as rendered.
  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One target per slot, PER PLACEMENT - the two lists number their slots from
  // zero independently. NOT unique on the target: nothing stops an admin
  // pointing two slots at one page, and the resolver dedupes rather than the
  // database rejecting a save mid-edit.
  @@unique([destinationId, placement, displayOrder])
  @@index([destinationId, placement])
  @@map("destination_popular_links")
}
