// Destinations domain — Caribbean islands + Activity Hubs
// Admin-only create. Operators cannot create destinations or hubs.
// Critical Rule #21–#23: slug_registry rows written in same transaction as entity create.

model Destination {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique // 'curacao', 'aruba' — always English
  heroImage String?
  isSeeded  Boolean @default(false) // true = seeded at launch; guard delete in service
  isActive  Boolean @default(true)
  createdBy String? // null = seeded; userId = admin who created

  // ── V2 fields ────────────────────────────────────────────────────────────────
  region              Region // geographic grouping (no URL layer) — V2 §2 (required)
  country             String?
  latitude            Float?
  longitude           Float?
  timezone            String? // IANA timezone, e.g. 'America/Curacao'
  currency            Currency? // default currency (ISO 4217 enum)
  language            String? // primary language code
  galleryImages       String[]      @default([])
  ogImage             String? // Open Graph image
  // Future sub-destinations (V2 §2) — nullable, unused at launch.
  parentDestinationId String?
  parentDestination   Destination?  @relation("DestinationParent", fields: [parentDestinationId], references: [id])
  subDestinations     Destination[] @relation("DestinationParent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator             User?                    @relation("DestinationCreator", fields: [createdBy], references: [id])
  hubs                Hub[]
  tours               Tour[]
  collections         Collection[]
  translations        DestinationTranslation[]
  pageContents        DestinationPageContent[]
  spotlightRequests   SpotlightRequest[]
  forceMajeurePardons ForceMajeurePardon[]

  @@index([slug])
  @@index([isActive])
  @@index([region])
  @@index([parentDestinationId])
  @@map("destinations")
}

// Per-locale translations for a destination.
// Destination names are proper nouns (Curaçao, Aruba) — never AI-translated.
// Admin sets manually. isMachineTranslated should always be false for destinations.
model DestinationTranslation {
  id                  String      @id @default(uuid())
  destinationId       String
  destination         Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  locale              Locale
  name                String? // localized display name; null falls back to Destination.name
  overview            String?
  h1Override          String?
  breadcrumbLabel     String?
  isMachineTranslated Boolean     @default(false)
  updatedAt           DateTime    @updatedAt

  @@unique([destinationId, locale])
  @@index([destinationId, locale])
  @@map("destination_translations")
}

// Per-locale editorial page content for a destination (about text, SEO metadata).
model DestinationPageContent {
  id              String      @id @default(uuid())
  destinationId   String
  destination     Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  locale          Locale
  aboutText       String?
  metaTitle       String?
  metaDescription String?

  @@unique([destinationId, locale])
  @@index([destinationId, locale])
  @@map("destination_page_content")
}

// Activity Hubs — destination-specific special locations (e.g. Klein Curaçao)
// Admin-only create. Destination is mandatory.
model Hub {
  id            String    @id @default(uuid())
  destinationId String
  name          String
  slug          String // locale-independent English slug; unique per destination
  description   String? // master E.4 short_description (card/meta blurb)
  heroImage     String? // full-bleed hero — the hub's defining element (HUB-DATA.md G1)
  ogImage       String? // Open Graph image (E.4)
  // ── V2 fields (Stage 1) ──────────────────────────────────────────────────────
  // `hubType` nullable in Stage 1; backfilled in Stage 2.
  hubType       HubType? // location | highlight | area — V2 §5
  status        HubStatus @default(DRAFT) // publish lifecycle (G6)
  latitude      Float? // for location-type hubs
  longitude     Float?
  isSeeded      Boolean   @default(false) // true = seeded at launch; guard delete in service
  isActive      Boolean   @default(true)
  createdBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destination       Destination          @relation(fields: [destinationId], references: [id])
  creator           User?                @relation("HubCreator", fields: [createdBy], references: [id])
  allowedCategories HubAllowedCategory[]
  ourPicks          HubOurPick[]
  comparisonGroups  HubComparisonGroup[]
  contentSections   HubContentSection[] // Discover / Local Tips / Fast Facts / Editorial
  translations      HubTranslation[]
  pageContents      HubPageContent[]
  tourHubs          TourHub[]

  @@unique([destinationId, slug])
  @@index([destinationId])
  @@map("hubs")
}

// Per-locale translations for a hub.
// Hub names are proper nouns (Klein Curaçao) — never AI-translated. Admin sets manually.
model HubTranslation {
  id                  String   @id @default(uuid())
  hubId               String
  hub                 Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  locale              Locale
  name                String? // null falls back to Hub.name
  overview            String? // editorial lead ("Why {hub}", ≤150 words, no visible header)
  heroTagline         String? // hero subtitle under H1 ("Where islanders send their visitors") — G5
  h1Override          String?
  breadcrumbLabel     String?
  isMachineTranslated Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  @@unique([hubId, locale])
  @@index([hubId, locale])
  @@map("hub_translations")
}

// Per-locale editorial page content for a hub (about text, SEO metadata).
model HubPageContent {
  id              String  @id @default(uuid())
  hubId           String
  hub             Hub     @relation(fields: [hubId], references: [id], onDelete: Cascade)
  locale          Locale
  aboutText       String?
  metaTitle       String?
  metaDescription String?

  @@unique([hubId, locale])
  @@index([hubId, locale])
  @@map("hub_page_content")
}

// Defines which categories of tours may be assigned to a hub.
// Operator tour creation checks this before showing the hub selector.
model HubAllowedCategory {
  id         String @id @default(uuid())
  hubId      String
  categoryId String

  hub      Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([hubId, categoryId])
  @@map("hub_allowed_categories")
}

// Admin editorial "Our Pick" selections for a hub page tab.
model HubOurPick {
  id           String      @id @default(uuid())
  hubId        String
  tourId       String
  pickType     HubPickType
  description  String // base-locale editorial blurb (fallback)
  displayOrder Int         @default(0)

  hub          Hub                     @relation(fields: [hubId], references: [id], onDelete: Cascade)
  tour         Tour                    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  translations HubOurPickTranslation[]

  @@unique([hubId, tourId])
  @@map("hub_our_picks")
}

// Per-locale Our-Pick blurb (G8).
model HubOurPickTranslation {
  id          String     @id @default(uuid())
  ourPickId   String
  locale      Locale
  description String
  ourPick     HubOurPick @relation(fields: [ourPickId], references: [id], onDelete: Cascade)

  @@unique([ourPickId, locale])
  @@map("hub_our_pick_translations")
}

// Comparison groups for the hub's "Compare" tab (e.g. "Comfort trips" vs "Adventure trips").
model HubComparisonGroup {
  id           String @id @default(uuid())
  hubId        String
  groupName    String // base-locale label (fallback)
  displayOrder Int    @default(0)

  hub             Hub                             @relation(fields: [hubId], references: [id], onDelete: Cascade)
  comparisonTours HubComparisonTour[]
  translations    HubComparisonGroupTranslation[]

  @@map("hub_comparison_groups")
}

// Per-locale comparison group name (G3).
model HubComparisonGroupTranslation {
  id        String             @id @default(uuid())
  groupId   String
  locale    Locale
  groupName String
  group     HubComparisonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, locale])
  @@map("hub_comparison_group_translations")
}

model HubComparisonTour {
  id           String  @id @default(uuid())
  groupId      String
  tourId       String
  standoutNote String? // base-locale "what stands out" cell (curated; G3)
  displayOrder Int     @default(0)

  group        HubComparisonGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tour         Tour                           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  translations HubComparisonTourTranslation[]

  @@unique([groupId, tourId])
  @@map("hub_comparison_tours")
}

// Per-locale "what stands out" comparison cell (G3).
model HubComparisonTourTranslation {
  id               String            @id @default(uuid())
  comparisonTourId String
  locale           Locale
  standoutNote     String
  comparisonTour   HubComparisonTour @relation(fields: [comparisonTourId], references: [id], onDelete: Cascade)

  @@unique([comparisonTourId, locale])
  @@map("hub_comparison_tour_translations")
}

// Hub editorial content blocks (HUB-DATA.md §5): Discover deep-dive subsections, Local
// Tips, the hero Fast Facts bar, and extra editorial blocks. Titled, ordered, per-locale.
model HubContentSection {
  id           String         @id @default(uuid())
  hubId        String
  locale       Locale
  sectionType  HubSectionType
  heading      String
  body         String
  displayOrder Int            @default(0)

  hub Hub @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@index([hubId, locale, sectionType, displayOrder])
  @@map("hub_content_sections")
}

// "Top Island Experiences" section — categories and hubs only, never individual tours.
// Admin manually curates + attaches video clips.
model FeaturedExperience {
  id            String             @id @default(uuid())
  entityType    FeaturedEntityType // CATEGORY | HUB only
  entityId      String // id of the Category or Hub
  destinationId String? // null = show everywhere; set = show for that destination only
  videoUrl      String?
  displayOrder  Int                @default(0)
  isActive      Boolean            @default(true)

  @@index([entityType, entityId])
  @@index([destinationId])
  @@map("featured_experiences")
}
