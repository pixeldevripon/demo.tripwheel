// Categories domain — activity types (Boat Tours, Sunset Cruises, etc.)
// Admin-only create. Categories are GLOBAL — not destination-specific.
// On create: slug_registry rows inserted for ALL active destinations (same transaction).

model Category {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique // 'boat-tours' — always English, globally unique
  heroImage String? // optional banner/thumbnail image URL
  ogImage   String? // Open Graph image (SEO social card)
  isSeeded  Boolean @default(false)
  isActive  Boolean @default(true)
  createdBy String? // null = seeded; userId = admin who created

  // ── V2 fields (Stage 1) ──────────────────────────────────────────────────────
  description      String? // canonical English description (translations carry localized overview)
  icon             String? // icon identifier for UI — V2 §3
  sortOrder        Int        @default(0) // display order in nav/filter
  // Future sub-categories (V2 §3) — nullable, unused at launch, no URL impact.
  parentCategoryId String?
  parentCategory   Category?  @relation("CategoryParent", fields: [parentCategoryId], references: [id])
  subCategories    Category[] @relation("CategoryParent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator        User?                 @relation("CategoryCreator", fields: [createdBy], references: [id])
  allowedInHubs  HubAllowedCategory[]
  tourCategories TourCategory[]
  translations   CategoryTranslation[]
  pageContents   CategoryPageContent[]
  // Fanned CTA cards on the homepage advertising this category (SetNull).
  homeEditorialCards HomePageEditorialCard[]

  @@index([slug])
  @@index([parentCategoryId])
  @@map("categories")
}

// Per-locale editorial page content for a category (about text, SEO metadata).
model CategoryPageContent {
  id              String   @id @default(uuid())
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale          Locale
  aboutText       String?
  metaTitle       String?
  metaDescription String?

  @@unique([categoryId, locale])
  @@index([categoryId, locale])
  @@map("category_page_content")
}

// Per-locale translations for a category.
// English content lives on Category.name; all other locales (and optional English
// overrides for overview/h1Override/breadcrumbLabel) go here.
model CategoryTranslation {
  id                  String   @id @default(uuid())
  categoryId          String
  category            Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale              Locale
  name                String? // localized name; null falls back to Category.name
  overview            String?
  h1Override          String?
  breadcrumbLabel     String?
  isMachineTranslated Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  @@unique([categoryId, locale])
  @@index([categoryId, locale])
  @@map("category_translations")
}
