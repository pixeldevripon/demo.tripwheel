// Tours domain — Tour and all related child models.
// Operators create tours; admins can moderate. Per-traveler pricing is a flat list of
// TourAgeBand rows on the Tour (Adult / Child / Infant …). Publish blocks: <5 images,
// no hero, overview empty, highlights <3.

model Tour {
  id            String @id @default(uuid())
  operatorId    String
  destinationId String
  // V2 §4: a tour belongs to 1+ categories (one primary) and 0–n hubs — see TourCategory / TourHub.

  name   String // canonical English name
  slug   String // English only, unique per destination
  status TourStatus @default(DRAFT)

  // ── OCTO product attributes ──
  timeZone             String // IANA; always derived from the destination on create (no universal fallback)
  availabilityType     OctoAvailabilityType @default(START_TIME)
  instantConfirmation  Boolean              @default(true)
  instantDelivery      Boolean              @default(true)
  availabilityRequired Boolean              @default(true)
  allowFreesale        Boolean              @default(false)
  deliveryFormats      DeliveryFormat[]     @default([PDF_URL, QRCODE])
  deliveryMethods      DeliveryMethod[]     @default([VOUCHER])
  redemptionMethod     RedemptionMethod     @default(DIGITAL)
  reference            String? // operator's external id (OCTO reference)

  // ── Pricing model ──
  pricingModel       PricingModel   @default(PER_PERSON) // → OCTO pricingPer
  wholeUnitType      WholeUnitType? // when pricingModel = UNIT (boat/vehicle…)
  defaultCurrency    Currency       @default(USD)
  basePrice          Decimal?       @db.Decimal(10, 2)
  priceFrom          Decimal?       @db.Decimal(10, 2) // cached "From $X" anchor: default band (PER_PERSON) / basePrice (UNIT)
  // UNIT (whole-asset / charter) pricing: base covers `unitIncludedGuests`
  // travelers; each additional traveler up to maxPartySize costs `extraPersonPrice`.
  // Both null for PER_PERSON tours (priced via TourAgeBand).
  unitIncludedGuests Int? // guests covered by basePrice ("/10 people")
  extraPersonPrice   Decimal?       @db.Decimal(10, 2) // surcharge per traveler beyond unitIncludedGuests

  // ── Operational / booking logic (master E.3) ──
  durationMinutesFrom  Int?
  durationMinutesTo    Int?
  pickupModel          PickupModel      @default(NONE)
  pickupRequired       Boolean          @default(false) // → OCTO option.pickupRequired
  minPartySize         Int              @default(1) // minimum travelers per booking
  maxPartySize         Int? // maximum travelers per booking
  bookingCutoffMinutes Int              @default(120) // → availability.utcCutoffAt
  cancellationHours    Int              @default(48) // enum-bound [24,48,72,168]
  startTimes           String[]         @default([]) // the tour's slot set ('HH:MM'); availability schedules switch these on per weekday
  paymentModel         PaymentModel     @default(OPERATOR_LINK)
  // Only meaningful when paymentModel = ON_ARRIVAL: whether the operator takes card
  // on site or cash only. Snapshotted onto the Booking at reserve (rule #21) so a
  // later operator edit never rewrites what a confirmed traveler was told.
  onArrivalPayment     OnArrivalPayment @default(CARD_OR_CASH)
  depositPct           Decimal          @default(20.0) @db.Decimal(4, 1) // 20–30 in 2.5 steps (tier-driven)

  // ── Commercial engine (master) ──
  commissionTier          Decimal          @default(20.0) @db.Decimal(4, 1) // 20/22.5/25/27.5/30 (+35 spotlight)
  tierKey                 TierKey          @default(standard)
  tierRank                Int              @default(5) @db.SmallInt // denormalized; never client-written
  tierLockedUntil         DateTime?
  qualityScore            Decimal          @default(0) @db.Decimal(6, 2) // nightly job
  eligibilityState        EligibilityState @default(LOCKED)
  graceStartedAt          DateTime? // G7 — when the 30-day eligibility grace began
  graceMetric             String? // which metric failed (rating | review_count | cancellation_rate)
  isBookable              Boolean          @default(false) // ≥1 AVAILABLE departure ≤30d (nightly)
  availabilityConfirmedAt DateTime? // G8 — operator "availability is current" freshness nudge
  firstPublishedAt        DateTime?

  // ── SEO / Content overrides ──
  h1Override      String?
  breadcrumbLabel String?
  ogImage         String? // master E.3 SEO block — single Open Graph image (Tour-level; meta_title/description are per-locale on TourTranslation)

  // ── Meeting point / departure (master E.3; localized text in TourTranslation) ──
  meetingPointLat      Float?
  meetingPointLng      Float?
  departureCity        String?
  checkInMinutesBefore Int?    @default(30) // "Please arrive N minutes early for check-in" on the Meeting & Pickup block (Figma; master default 30)

  // ── Audience / accessibility flags (master E.3 — power filters, badges, JSON-LD) ──
  minAgeYears          Int? // tour-level minimum age (distinct from per-band TourAgeBand.minAge)
  fitnessLevel         FitnessLevel?
  bookingType          TourBookingType? // private | shared
  weatherDependent     Boolean          @default(false)
  wheelchairAccessible Boolean          @default(true) // master E.3/LD23: most tours assumed accessible unless explicitly not
  familyFriendly       Boolean          @default(false)
  suitableForBeginners Boolean          @default(false)
  isLocalsFavourite    Boolean          @default(false)

  // ── Cached review aggregates (updated on review approve) ──
  aggregateRating      Float?
  aggregateReviewCount Int       @default(0)
  aggregatesUpdatedAt  DateTime?
  ratingDistribution   Int[]     @default([]) // [5★,4★,3★,2★,1★] counts — star chart (LD31)
  photoReviewCount     Int       @default(0) // photo carousel activates at ≥3 photo reviews

  // ── CRO counters (V2 §10) ──
  bookingCount      Int       @default(0)
  bookingCountToday Int       @default(0)
  spotsRemaining    Int?
  lastBookedAt      DateTime?

  // ── Flags ──
  isSponsored Boolean @default(false)
  isActive    Boolean @default(true)

  // ── Demand signal (master §3.7) - powers the "Likely to sell out" badge.
  // `likelyToSellOut` is the daily worker output (tour_age >= 90d AND >= 3 sellouts
  // in 60d AND < 40% availability over the next 30d - see src/tours/demand-signal.ts).
  // `likelyToSellOutOverride` is the manual CMS launch override (null = use the
  // computed value; true/false = force). deriveTourBadge reads `override ?? computed`.
  likelyToSellOut         Boolean  @default(false)
  likelyToSellOutOverride Boolean?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  operator           Operator                @relation(fields: [operatorId], references: [id])
  destination        Destination             @relation(fields: [destinationId], references: [id])
  ageBands           TourAgeBand[] // flat per-traveler pricing (Adult / Child / Infant …)
  categories         TourCategory[] // 1+ categories, exactly one isPrimary
  hubs               TourHub[] // 0–n hubs
  attributes         TourAttribute[] // V2 §7 — filterable key-value properties
  images             TourImage[]
  addOns             TourAddOn[]
  languages          TourLanguage[]
  highlights         TourHighlight[]
  inclusions         TourInclusion[]
  exclusions         TourExclusion[]
  features           TourFeature[] // OTHER OCTO feature types (terms, accessibility…) — DS1
  locations          TourLocation[] // OCTO locations / itinerary
  pickupLocations    PickupLocation[] // OCTO pickup points (octo/pickups)
  translations       TourTranslation[]
  schedules          AvailabilitySchedule[]
  exceptions         AvailabilityException[]
  departures         Departure[]
  bookings           Booking[]
  reviews            Review[]
  wishlists          Wishlist[]
  spotlightRequests  SpotlightRequest[]
  hubOurPicks        HubOurPick[]
  hubComparisonTours HubComparisonTour[]
  collectionTours    CollectionTour[]

  @@unique([destinationId, slug])
  @@index([operatorId])
  @@index([destinationId])
  @@index([status])
  @@index([tierRank, qualityScore]) // ranking
  @@index([isBookable])
  @@map("tours")
}

// ── TourAgeBand — typed per-traveler pricing ──────────────────────────────────
// One row per priced band, typed by bandType (Adult / Child / Infant / Youth / Senior).
// The API composes a typed pricing object keyed by band (pricing.adult, pricing.child …).
// participation=SPECTATOR bands are banded ride-alongs (count toward capacity, excluded
// from the activity). One booking line item per traveler references the band it was sold
// at. Replaces the OCTO option/unit hierarchy — one seat per traveler.
model TourAgeBand {
  id     String @id @default(uuid())
  tourId String

  bandType      AgeBandType // ADULT/CHILD/INFANT/YOUTH/SENIOR — lets the API compose pricing.adult etc.
  participation BandParticipation @default(PARTICIPANT) // PARTICIPANT (default) | SPECTATOR (Figma "Bringing Spectators?")
  label         String // 'Adult', 'Child (4-12)', 'Infant'
  minAge        Int? // inclusive lower bound (null = no lower bound)
  maxAge        Int? // inclusive upper bound (null = no upper bound)

  // Pricing (Decimal in DB)
  price         Decimal  @db.Decimal(10, 2) // retail price per traveler
  priceOriginal Decimal? @db.Decimal(10, 2) // optional pre-discount/strikethrough
  priceNet      Decimal? @db.Decimal(10, 2) // optional operator net

  isDefault    Boolean @default(false) // the band the UI/booking defaults to (e.g. Adult)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tour         Tour              @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookingItems BookingUnitItem[]

  @@index([tourId])
  @@map("tour_age_bands")
}

// ── Tour ↔ Category (many-to-many, V2 §4) ─────────────────────────────────────
model TourCategory {
  id         String  @id @default(uuid())
  tourId     String
  categoryId String
  isPrimary  Boolean @default(false)

  tour     Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([tourId, categoryId])
  @@index([categoryId])
  @@index([tourId, isPrimary])
  @@map("tour_categories")
}

// ── Tour ↔ Activity Hub (many-to-many, V2 §4/§5) ──────────────────────────────
model TourHub {
  id     String @id @default(uuid())
  tourId String
  hubId  String

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)
  hub  Hub  @relation(fields: [hubId], references: [id])

  @@unique([tourId, hubId])
  @@index([hubId])
  @@map("tour_hubs")
}

// ── Tour Images ───────────────────────────────────────────────────────────────
model TourImage {
  id           String  @id @default(uuid())
  tourId       String
  url          String // JPEG/WebP URL (primary)
  urlAvif      String? // AVIF variant
  urlWebp      String? // WebP variant
  isHero       Boolean @default(false)
  focalX       Float   @default(0.5)
  focalY       Float   @default(0.5)
  altText      String?
  displayOrder Int     @default(0)
  width        Int
  height       Int

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId, displayOrder])
  @@map("tour_images")
}

// ── Add-Ons ───────────────────────────────────────────────────────────────────
// EU Digital Fairness Act: never pre-checked in frontend — always starts unchecked.
model TourAddOn {
  id           String    @id @default(uuid())
  tourId       String
  name         String
  description  String?
  price        Decimal   @db.Decimal(10, 2)
  unit         AddOnUnit @default(PER_PERSON)
  maxQuantity  Int       @default(1)
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)

  tour     Tour           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookings BookingAddOn[]

  @@index([tourId])
  @@map("tour_addons")
}

// ── Tour Languages ────────────────────────────────────────────────────────────
model TourLanguage {
  id       String @id @default(uuid())
  tourId   String
  language String // ISO 639-1 code

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, language])
  @@map("tour_languages")
}

// ── Highlights ────────────────────────────────────────────────────────────────
// 3–6 bullet points per tour. Serialized into OCTO content features[] as HIGHLIGHT.
model TourHighlight {
  id           String  @id @default(uuid())
  tourId       String
  displayOrder Int     @default(0)
  imageUrl     String?

  tour         Tour                       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  translations TourHighlightTranslation[]

  @@index([tourId, displayOrder])
  @@map("tour_highlights")
}

model TourHighlightTranslation {
  id                  String  @id @default(uuid())
  highlightId         String
  locale              Locale
  text                String
  isMachineTranslated Boolean @default(false)

  highlight TourHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  @@unique([highlightId, locale])
  @@map("tour_highlight_translations")
}

// ── Inclusions ────────────────────────────────────────────────────────────────
// Serialized into OCTO content features[] as INCLUSION.
model TourInclusion {
  id           String  @id @default(uuid())
  tourId       String
  icon         String  @default("check")
  displayOrder Int     @default(0)
  imageUrl     String?

  tour         Tour                       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  translations TourInclusionTranslation[]

  @@index([tourId])
  @@map("tour_inclusions")
}

model TourInclusionTranslation {
  id                  String  @id @default(uuid())
  inclusionId         String
  locale              Locale
  label               String
  isMachineTranslated Boolean @default(false)

  inclusion TourInclusion @relation(fields: [inclusionId], references: [id], onDelete: Cascade)

  @@unique([inclusionId, locale])
  @@map("tour_inclusion_translations")
}

// ── Exclusions ────────────────────────────────────────────────────────────────
// Serialized into OCTO content features[] as EXCLUSION.
model TourExclusion {
  id           String         @id @default(uuid())
  tourId       String
  icon         String         @default("x")
  type         ExclusionType? // LD18 — paid_advance | paid_onsite | unavailable | not_permitted
  priceText    String? // e.g. "$15 per person" when type is PAID_*
  displayOrder Int            @default(0)
  imageUrl     String?

  tour         Tour                       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  translations TourExclusionTranslation[]

  @@index([tourId])
  @@map("tour_exclusions")
}

model TourExclusionTranslation {
  id                  String  @id @default(uuid())
  exclusionId         String
  locale              Locale
  label               String
  isMachineTranslated Boolean @default(false)

  exclusion TourExclusion @relation(fields: [exclusionId], references: [id], onDelete: Cascade)

  @@unique([exclusionId, locale])
  @@map("tour_exclusion_translations")
}

// ── OCTO content features OTHER than highlight/inclusion/exclusion (DS1) ───────
// terms, accessibility, prebooking/prearrival info, redemption, additional info.
model TourFeature {
  id           String      @id @default(uuid())
  tourId       String
  type         FeatureType // not HIGHLIGHT/INCLUSION/EXCLUSION
  displayOrder Int         @default(0)

  tour         Tour                     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  translations TourFeatureTranslation[]

  @@index([tourId, type])
  @@map("tour_features")
}

model TourFeatureTranslation {
  id                  String  @id @default(uuid())
  featureId           String
  locale              Locale
  text                String
  isMachineTranslated Boolean @default(false)

  feature TourFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([featureId, locale])
  @@map("tour_feature_translations")
}

// ── OCTO locations / itinerary (start, itinerary item, end, POI…) ─────────────
model TourLocation {
  id              String   @id @default(uuid())
  tourId          String
  types           String[] @default([]) // ["START"], ["ITINERARY_ITEM"], ["END"] …
  latitude        Float?
  longitude       Float?
  streetAddress   String?
  addressLocality String?
  addressRegion   String?
  postalCode      String?
  addressCountry  String?
  minutesTo       Int?
  minutesAt       Int?
  displayOrder    Int      @default(0)

  tour         Tour                      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  translations TourLocationTranslation[]

  @@index([tourId])
  @@map("tour_locations")
}

model TourLocationTranslation {
  id                  String  @id @default(uuid())
  locationId          String
  locale              Locale
  title               String
  shortDescription    String?
  isMachineTranslated Boolean @default(false)

  location TourLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, locale])
  @@map("tour_location_translations")
}

// ── Pickup locations (octo/pickups; D12 — first-class pickup points) ───────────
// Distinct from TourLocation (itinerary/start/end). A PAID_ADDON pickup is also linked
// to a TourAddOn for charging; this model carries the geo + selectable point.
model PickupLocation {
  id           String   @id @default(uuid())
  tourId       String
  name         String // e.g. "Marriott Beach Resort — main lobby"
  latitude     Float?
  longitude    Float?
  address      String?
  // Per-person pickup price in the tour's defaultCurrency (master 5.8: "operator zones
  // with prices", label "Pickup location (From $X p.p.)"). Charged ONLY when the tour's
  // pickupModel = PAID_ADDON; ignored (free) on INCLUDED. Null/0 = free zone.
  price        Decimal? @db.Decimal(10, 2)
  minutesPrior Int? // pickup happens N minutes before departure
  windowStart  String? // pickup window start ('HH:MM') — Figma "7:45–8:15 AM window"
  windowEnd    String? // pickup window end ('HH:MM')
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  tour         Tour                        @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  translations PickupLocationTranslation[]

  @@index([tourId])
  @@map("pickup_locations")
}

model PickupLocationTranslation {
  id                  String  @id @default(uuid())
  pickupLocationId    String
  locale              Locale
  title               String // localized point name
  directions          String? // localized pickup directions
  isMachineTranslated Boolean @default(false)

  pickupLocation PickupLocation @relation(fields: [pickupLocationId], references: [id], onDelete: Cascade)

  @@unique([pickupLocationId, locale])
  @@map("pickup_location_translations")
}

// ── Tour Translations ─────────────────────────────────────────────────────────
// Per-locale content for title/overview/description (renamed from TripTranslation).
model TourTranslation {
  id                  String   @id @default(uuid())
  tourId              String
  locale              Locale
  title               String?
  overview            String? // 80–200 words, paragraph breaks only
  description         String? // long description, 350–500 words
  // ── Marketing / info content (master E.3, LD19/LD22/LD23) ──
  shortDescription    String? // card/preview teaser — 160 char cap (DTO @MaxLength(160))
  whatToBring         String[] @default([]) // 3–8 bullets, ≤25 words each (master string[])
  knowBeforeYouGo     String[] @default([]) // 3–10 bullets, ≤25 words each (master string[])
  notSuitableFor      String[] @default([]) // 1–6 bullets when present; hidden when empty (master string[])
  whatToExpectIntro   String? // intro paragraph above the numbered itinerary on the "What to Expect" tab (Figma)
  categoryDisplay     String? // plural noun phrase for "More {x} in {destination}" (LD33); CMS validates plural
  localTipTitle       String? // "local tip" callout headline, e.g. "Book the morning departure" (LD22, Figma)
  localTipBody        String? // "local tip" callout description, e.g. "Afternoon wind picks up…" (LD22, Figma)
  // Operator's own message to the traveller, rendered as the "A note from
  // {operatorName}" card in the confirmation email (wireframe Block 4b). Localized
  // because the email is sent in the traveller's locale. Empty hides the card.
  operatorNote        String?
  meetingPointText    String? // localized meeting-point description (geo on Tour)
  metaTitle           String? // SEO (master E.3 SEO block, localized)
  metaDescription     String? // SEO (master E.3 SEO block, localized)
  isMachineTranslated Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, locale])
  @@index([tourId, locale])
  @@map("tour_translations")
}
