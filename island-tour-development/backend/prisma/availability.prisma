// Availability domain (master E.9) — weekly schedules + date exceptions
// materialize into Departure rows, the single source of truth for bookable
// inventory. Capacity lives per departure, never on the tour or schedule.

// Recurring weekly pattern (operator-authored). One row per tour × weekday ×
// startTime; the Tour.startTimes[] slot set defines which times are allowed.
model AvailabilitySchedule {
  id        String   @id @default(uuid())
  tourId    String
  weekday   Int      @db.SmallInt // 0=Monday … 6=Sunday (tour-local)
  startTime DateTime @db.Time(0) // must exist in Tour.startTimes[]

  capacityOverride Int? // null = Tour.maxPartySize default
  validFrom        DateTime                   @db.Date
  validUntil       DateTime?                  @db.Date
  status           AvailabilityScheduleStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, weekday, startTime, validFrom])
  @@index([tourId, weekday, status])
  @@map("availability_schedules")
}

// Date-specific deviation. close_date / close_slot are stop-sell actions;
// add_slot creates an extra departure, set_capacity overrides one date/slot.
model AvailabilityException {
  id        String                    @id @default(uuid())
  tourId    String
  date      DateTime                  @db.Date
  startTime DateTime?                 @db.Time(0) // null = whole date
  type      AvailabilityExceptionType
  capacity  Int? // for add_slot / set_capacity
  note      String?
  createdBy String?

  // One id shared by every row a single bulk blackout wrote (closeRange), null
  // for a one-date closure. The demand signal counts operator closures as
  // sell-outs (§3.7), and a two-week haul-out is ONE operator action - without
  // this it would count as fourteen and trip the badge on its own.
  closureBatchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId, date])
  @@index([tourId, date, startTime])
  // Demand signal: whole-day closures for a tour inside the 60-day window.
  @@index([tourId, type, createdAt])
  @@map("availability_exceptions")
}

// Materialized truth: one concrete bookable instance per tour × date × startTime.
// Booking claims increment bookedCount atomically and can flip status to SOLD_OUT.
model Departure {
  id     String @id @default(uuid())
  tourId String

  date      DateTime @db.Date
  startTime DateTime @db.Time(0)

  capacity    Int
  bookedCount Int             @default(0)
  status      DepartureStatus @default(OPEN)
  soldOutAt   DateTime? // stamped once when the row fills; feeds demand signals

  source         DepartureSource @default(SCHEDULE)
  externalRef    String? // operator/external system id when source = API
  manuallyEdited Boolean         @default(false) // protects from re-materialization

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tour     Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookings Booking[]
  reviews  Review[]

  @@unique([tourId, date, startTime])
  @@index([tourId, date])
  @@index([tourId, status, date])
  @@map("departures")
}
