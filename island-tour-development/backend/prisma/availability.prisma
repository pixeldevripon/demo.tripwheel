// Availability domain (master E.9) — weekly schedules + date exceptions
// materialize into Departure rows, the single source of truth for bookable
// inventory. Capacity lives per departure, never on the tour or schedule.

// Recurring weekly pattern (operator-authored). One row per tour × weekday ×
// startTime; the Tour.startTimes[] slot set defines which times are allowed.
model AvailabilitySchedule {
  id        String   @id @default(uuid())
  tourId    String
  weekday   Int      @db.SmallInt // 0=Monday … 6=Sunday (tour-local)
  startTime DateTime @db.Time(0) // must exist in Tour.startTimes[]

  capacityOverride Int? // null = Tour.maxPartySize default
  validFrom        DateTime                   @db.Date
  validUntil       DateTime?                  @db.Date
  status           AvailabilityScheduleStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, weekday, startTime, validFrom])
  @@index([tourId, weekday, status])
  @@map("availability_schedules")
}

// Date-specific deviation. close_date / close_slot are stop-sell actions;
// add_slot creates an extra departure, set_capacity overrides one date/slot.
model AvailabilityException {
  id        String                    @id @default(uuid())
  tourId    String
  date      DateTime                  @db.Date
  startTime DateTime?                 @db.Time(0) // null = whole date
  type      AvailabilityExceptionType
  capacity  Int? // for add_slot / set_capacity
  note      String?
  createdBy String?

  // ── Provenance (inbound iCal) ───────────────────────────────────────────────
  // An imported busy block becomes a CLOSE_DATE / CLOSE_SLOT row here and
  // nowhere else - never a departure, never a capacity change (see
  // calendar-sync.prisma). These columns are what let the reconciler diff ONLY
  // its own rows and leave every operator-authored exception untouched.
  source         AvailabilityExceptionSource @default(MANUAL)
  subscriptionId String?
  /// The originating VEVENT's UID, so an event removed upstream can release
  /// exactly the blocks it created and nothing else.
  externalUid    String?
  /// `'HH:MM'` for a CLOSE_SLOT, `'*'` for a whole-date close. Exists only to
  /// make the unique below work: `startTime` is nullable, and Postgres treats
  /// NULLs as distinct, so a whole-date block could otherwise be written twice
  /// by two racing syncs.
  slotKey        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tour         Tour                  @relation(fields: [tourId], references: [id], onDelete: Cascade)
  subscription CalendarSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// Inert for operator-authored rows (`subscriptionId` is NULL, and a unique
  /// containing NULL never collides in Postgres), so manual exceptions stay
  /// unconstrained. For imported rows it is a safety net against double-writes.
  @@unique([subscriptionId, externalUid, date, slotKey])
  @@index([tourId, date])
  @@index([tourId, date, startTime])
  @@index([subscriptionId])
  @@map("availability_exceptions")
}

// Materialized truth: one concrete bookable instance per tour × date × startTime.
// Booking claims increment bookedCount atomically and can flip status to SOLD_OUT.
model Departure {
  id     String @id @default(uuid())
  tourId String

  date      DateTime @db.Date
  startTime DateTime @db.Time(0)

  capacity    Int
  bookedCount Int             @default(0)
  status      DepartureStatus @default(OPEN)
  soldOutAt   DateTime? // stamped once when the row fills; feeds demand signals

  source         DepartureSource @default(SCHEDULE)
  externalRef    String? // operator/external system id when source = API
  manuallyEdited Boolean         @default(false) // protects from re-materialization

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tour      Tour               @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  reviews   Review[]
  conflicts CalendarConflict[]

  @@unique([tourId, date, startTime])
  @@index([tourId, date])
  @@index([tourId, status, date])
  @@map("departures")
}
