// Island Tours' own places to stay - the promo card at the foot of the thank-you
// page (TYP). These are OUR properties, advertised to a traveller who has just
// booked a tour, so they are admin-managed marketing content and NOT operator
// listings: they never enter search, ranking, availability or the booking flow.
//
// A LIST, not a singleton. The thank-you page renders exactly ONE card (a 50/50
// photo-and-details split, fixed in the site design), so the public read serves
// the first renderable hotel by `displayOrder`. Holding several rows is about
// being able to swap which property is promoted - and to keep the retired one's
// copy - without retyping it every season.
//
// PRE-SEEDED AND PROTECTED: the first row ships carrying the values the card was
// hardcoded with, and carries `isSeeded`, which makes it undeletable exactly like
// a seeded destination. Going dynamic therefore changed nothing on screen, and the
// section can never be left with no content by an accidental delete.
//
// THE RENDER GATE, and why it is not the usual "null = dictionary fallback": the
// homepage's nullable fields each have a bundled English default to fall back to,
// but a property's name, photo and rating have no sensible built-in - inventing
// one would advertise a place that does not exist. So the essentials (image +
// title + booking link) are the gate: a hotel missing any of them is skipped, and
// when no hotel qualifies the payload reports `enabled: false` and the section
// does not render at all. Everything else is optional and its own row of the card
// hides on its own.
model Hotel {
  id String @id @default(uuid())

  /// Whether this hotel may be promoted at all. Off takes it out of the running
  /// without deleting the content - the admin's way to retire a property, and
  /// the way to hand the card to the next one in order.
  isEnabled Boolean @default(true)

  /// Which hotel the card shows: the lowest `displayOrder` among the enabled,
  /// complete ones wins, `id` breaking ties. The page renders one card, so this
  /// is a priority list rather than a layout.
  displayOrder Int @default(0)

  /// Seed protection, same contract as `Destination.isSeeded`: the service
  /// refuses to delete a row carrying it (403). The promo keeps one guaranteed
  /// occupant that way, so the section cannot be emptied by an accidental
  /// delete - only switched off deliberately via `isEnabled`.
  isSeeded Boolean @default(false)

  /// The photo filling the left half of the card. Part of the render gate: the
  /// layout is a 50/50 split, so there is no card without it.
  imageUrl String?

  /// Where "See availability" goes (Airbnb, Booking.com, our own page - the
  /// label is admin-editable per locale for exactly that reason). Part of the
  /// render gate: the card's only action is this click, so without a
  /// destination it is a dead card and is better not shown.
  bookingUrl String?

  /// Guest rating as shown beside the star, e.g. 4.8. NOT computed from
  /// anything we hold: these are the host platform's reviews, typed in by an
  /// admin. Deliberately never joined to the platform's own Review rows, which
  /// are about tours.
  rating      Decimal? @db.Decimal(2, 1)
  reviewCount Int?

  /// "Sleeps 4".
  sleeps Int?

  /// "from $160/per night". The currency travels WITH the amount and the
  /// frontend renders that currency's symbol - the card must never print a
  /// hardcoded $ over a euro price.
  pricePerNight Decimal? @db.Decimal(10, 2)
  currency      Currency @default(USD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations HotelTranslation[]

  /// The public read's exact predicate and ordering.
  @@index([isEnabled, displayOrder, id])
  @@map("hotels")
}

// Per-locale hotel copy. Mirrors the *Translation pattern used by every other
// entity (locale column + compound unique + isMachineTranslated + sourceHash), so
// the Translation Console and the AI refresher pick it up by registration rather
// than needing bespoke UI.
//
// The NUMBERS live on the parent, not here: a rating is the same fact in every
// language, and duplicating it per locale would let seven copies disagree.
model HotelTranslation {
  id      String @id @default(uuid())
  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  locale  Locale

  /// Small caps label above the title ("🌴 OUR APARTMENT"). Null keeps the
  /// bundled dictionary label, which is already translated in all 7 locales.
  eyebrow String?

  /// The neighbourhood beside the eyebrow ("Jan Thiel"). Translatable because
  /// some locales transliterate place names, even though most will not change it.
  areaLabel String?

  /// The property name ("Palm Suite Apartment"). Part of the render gate, and
  /// the label the dashboard list shows for the row.
  title String?

  /// The short pitch under the meta row. NEWLINE-SEPARATED: the card renders
  /// one paragraph per line, which is how it holds the two-line Figma copy
  /// without inventing a repeatable child table for two short strings.
  description String?

  /// CTA label ("See availability on Airbnb"). Null keeps the bundled
  /// dictionary label. Editable because the destination is editable - an admin
  /// who points `bookingUrl` at Booking.com must be able to stop the button
  /// naming Airbnb.
  ctaLabel String?

  isMachineTranslated Boolean  @default(false)
  sourceHash          String? // sha1 of the EN source a machine row was built from
  updatedAt           DateTime @updatedAt

  @@unique([hotelId, locale])
  @@index([hotelId, locale])
  @@map("hotel_translations")
}
