/// marketing (MK-1). TRANSACTIONAL and INTERNAL never check opt-outs.
enum EmailStream {
  TRANSACTIONAL
  LIFECYCLE
  MARKETING
  INTERNAL
}

/// Outcome recorded on an `EmailSend` row. SUPPRESSED means the platform
/// DECIDED not to send (and why) — a decided row occupies the same unique
/// slot as a sent one, mirroring `ReviewInvitation.suppressedReason`.
enum EmailSendStatus {
  SENT
  FAILED
  SUPPRESSED
}

/// Who an opt-out belongs to. The same address can be a traveller AND an
/// operator; opting out of operator nudges must not silence traveller mail.
enum EmailAudience {
  TRAVELLER
  OPERATOR
}
