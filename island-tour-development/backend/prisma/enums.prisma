// OCTO content feature types. HIGHLIGHT/INCLUSION/EXCLUSION are sourced from their
// own dedicated tables (DS1); the rest are stored on TourFeature.
enum FeatureType {
  INCLUSION
  EXCLUSION
  HIGHLIGHT
  PREBOOKING_INFORMATION
  PREARRIVAL_INFORMATION
  REDEMPTION_INSTRUCTION
  ACCESSIBILITY_INFORMATION
  ADDITIONAL_INFORMATION
  BOOKING_TERM
  CANCELLATION_TERM
}

// ── Availability ──────────────────────────────────────────────────────────────

enum AvailabilityScheduleStatus {
  ACTIVE @map("active")
  PAUSED @map("paused")

  @@map("availability_schedule_status")
}

enum AvailabilityExceptionType {
  CLOSE_DATE   @map("close_date")
  CLOSE_SLOT   @map("close_slot")
  ADD_SLOT     @map("add_slot")
  SET_CAPACITY @map("set_capacity")

  @@map("availability_exception_type")
}

enum DepartureStatus {
  OPEN      @map("open")
  CLOSED    @map("closed")
  SOLD_OUT  @map("sold_out")
  CANCELLED @map("cancelled")

  @@map("departure_status")
}

enum DepartureSource {
  SCHEDULE  @map("schedule")
  EXCEPTION @map("exception")
  API       @map("api")

  @@map("departure_source")
}

