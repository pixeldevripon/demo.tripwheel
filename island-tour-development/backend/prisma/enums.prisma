// ── Tour ──────────────────────────────────────────────────────────────────────

enum TourStatus {
  DRAFT
  LIVE
  PAUSED
  ARCHIVED
}

// Pricing model — maps to OCTO `pricingPer` at the boundary.
enum PricingModel {
  PER_PERSON
  UNIT
}

// Whole-unit (asset-priced) tour types — used when pricingModel = UNIT.
// Asset-priced tour types (when pricingModel = UNIT — whole boat/vehicle/package).
enum WholeUnitType {
  GROUP
  BOAT
  VEHICLE
  AIRCRAFT
  PACKAGE
}

enum PickupModel {
  INCLUDED
  PAID_ADDON
  NONE
}

enum AddOnUnit {
  PER_PERSON
  FLAT
}

// Typed exclusions (LD18 / master E.3) — what an exclusion line actually means.
enum ExclusionType {
  PAID_ADVANCE // available but costs extra, pay in advance
  PAID_ONSITE // available but costs extra, pay on site
  UNAVAILABLE // simply not provided
  NOT_PERMITTED // not allowed on this tour
}

// Tour audience/accessibility flags (master E.3).
enum FitnessLevel {
  EASY
  MODERATE
  CHALLENGING
}

enum TourBookingType {
  PRIVATE
  SHARED
}

// Typed pricing bands (master E.3). ADULT/CHILD/INFANT cover the master's three base
// band prices; YOUTH/SENIOR cover the optional age_bands[] extras. Lets the API compose
// a typed pricing object keyed by band (pricing.adult, pricing.child, …).
enum AgeBandType {
  ADULT
  CHILD
  INFANT
  YOUTH
  SENIOR
}

// Whether a priced band takes part in the activity or only rides along (Figma booking
// widget "Bringing Spectators?"). Spectators are banded (Adult $20 / Kid $10) and count
// toward capacity but are excluded from the activity itself.
enum BandParticipation {
  PARTICIPANT
  SPECTATOR
}

