  OB6_CHECK_IN
  OB7_CONNECT_CALENDAR
  OB8_PAGE_STRONGER
  INT1_NEW_OPERATOR
  INT1R_PENDING_REMINDER
  INT2_NEW_TOUR
}

/// Compliance stream an email belongs to. Opt-outs are PER STREAM: LIFECYCLE
