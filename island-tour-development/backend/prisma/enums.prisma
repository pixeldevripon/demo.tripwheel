// ── Destinations & Hubs ───────────────────────────────────────────────────────

// Geographic grouping of destinations (V2 §2). Data attribute only — no URL layer.
enum Region {
  CARIBBEAN
  ATLANTIC
  MEDITERRANEAN
  ASIA
  AFRICA
}

// Activity-hub classification (V2 §5).
enum HubType {
  LOCATION
  HIGHLIGHT
  AREA
}

// Publish lifecycle for editorial pages (hubs/collections). DRAFT is the unpublished
// working state; PUBLISHED is live; ARCHIVED is retired (slug protected).
enum HubStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Hub editorial content blocks (HUB-DATA.md §5). Discover deep-dive subsections,
// first-timer Local Tips, the hero fast-facts bar, and any extra editorial blocks.
enum HubSectionType {
  DISCOVER
  LOCAL_TIP
  FAST_FACT
  EDITORIAL
}

// Supported currencies (ISO 4217). Launch set: Caribbean island currencies + major
// tourist source currencies. Used wherever a currency is stored/displayed.
enum Currency {
  USD
  EUR
}

enum SlugEntityType {
  TOUR
  CATEGORY
  HUB
  COLLECTION
  RESERVED
}

// Collections (V2 §6) — curated (manual) or filter-based (dynamic) editorial lists.
enum CollectionType {
  MANUAL
  DYNAMIC
}

// Collection publish lifecycle (COLLECTION-DATA.md §2 / G5).
enum CollectionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Collection card display style (COLLECTION-DATA.md §8). NUMBERED draws 01..n badges
// (Best Things to Do / Top 10); PERSONA marks card #1 with the peach highlight instead.
enum CollectionDisplayStyle {
  NUMBERED
  PERSONA
}

enum FeaturedEntityType {
  CATEGORY
  HUB
}

enum HubPickType {
  BEST_OVERALL
  MOST_POPULAR
  BEST_FOR_FAMILIES
  BEST_VALUE
}

