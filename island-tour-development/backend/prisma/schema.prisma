generator client {
  provider = "prisma-client-js"
}

// Connection URL is configured in prisma.config.ts (Prisma 7)
datasource db {
  provider = "postgresql"
}

// Domain models live in separate files alongside this one (OCTO-aligned):
//   enums.prisma          ← all enums
//   user.prisma           ← User, Session, Account, Verification (Better Auth)
//   operators.prisma      ← Operator (+ OCTO supplier contact + eligibility) + company/social/payment configs
//   staff.prisma          ← StaffMember (platform staff + operator team seats) + StaffDesignation
//   destinations.prisma   ← Destination, Hub, HubAllowedCategory, HubOurPick, HubComparisonGroup, FeaturedExperience
//   categories.prisma     ← Category
//   collections.prisma    ← Collection (+ translation, page content)
//   tours.prisma          ← Tour + TourAgeBand (flat per-traveler pricing) + content children (images, add-ons,
//                            languages, inclusions, exclusions, features, locations, translations)
//   availability.prisma   ← AvailabilitySchedule, AvailabilityException, Departure (= OCTO Availability)
//   calendar-feeds.prisma ← CalendarFeed (tokenized read-only iCal export of bookings / departures)
//   calendar-sync.prisma  ← CalendarSubscription, CalendarEvent, IcalSyncLog, CalendarConflict (inbound iCal import)
//   bookings.prisma       ← Booking (OCTO reserve→confirm) + BookingUnitItem (= OCTO unit item)
//   payments.prisma       ← Payment + StripeWebhookEvent (idempotent ledger)
//   reviews.prisma        ← Review (per-tour, booking-gated) + ReviewTranslation
//   tiers.prisma          ← SpotlightRequest (tier columns live on Tour)
//   notifications.prisma  ← NotificationSubscription + NotificationDelivery (octo/notifications)
//   attributes.prisma     ← AttributeDefinition, TourAttribute
//   slug-registry.prisma  ← SlugRegistry
//   faq.prisma            ← Faq (polymorphic)
//   wishlist.prisma       ← Wishlist
//   media-gallery.prisma  ← MediaGallery
//   settings.prisma       ← SiteInfo, SiteSEO, SocialMedia, Mailchimp, StripeConfiguration, etc. (email = Resend via env)
//   webhooks.prisma       ← Webhooks, WebhookPoint (internal Zapier/n8n lead catches — distinct from OCTO notifications)
