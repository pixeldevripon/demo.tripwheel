model MediaGallery {
  id           String   @id @default(uuid())
  url          String
  publicId     String   @unique
  resourceType String
  /// Original client filename - null for rows uploaded before this column existed
  originalName String?
  /// MIME type as received at upload (e.g. image/svg+xml, audio/mpeg)
  mimeType     String?
  /// Stored size in bytes (from Cloudinary)
  bytes        Int?
  /// Cloudinary format (jpg, svg, mp4, mp3, ...)
  format       String?
  uploadedAt   DateTime @default(now())
  userId       String
  uploadedBy   User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([id])
  @@index([publicId])
  @@index([url])
  @@index([userId])
  @@map("media_gallery")
}
