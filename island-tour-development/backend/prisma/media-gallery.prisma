model MediaGallery {
  id           String   @id @default(uuid())
  url          String
  publicId     String   @unique
  resourceType String
  uploadedAt   DateTime @default(now())
  userId       String
  uploadedBy   User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([id])
  @@index([publicId])
  @@index([url])
  @@index([userId])
  @@map("media_gallery")
}
