// ─────────────────────────────────────────────────────────────────────────────
// Company informations (singleton)
// ─────────────────────────────────────────────────────────────────────────────

model CompanyInformations {
  id String @id @default("default")

  companyName    String?
  companyEmail   String?
  companyPhone   String?
  companyWebsite String?
  companyAddress String?
  companyCity    String?
  companyState   String?
  companyZip     String?
  companyCountry String?
  companyVat     String?
