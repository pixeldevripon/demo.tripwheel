// ─────────────────────────────────────────────────────────────────────────────
// Core site information (singleton)
// ─────────────────────────────────────────────────────────────────────────────

model SiteInfo {
  id String @id @default("default")

  siteName         String? @default("")
  siteTagline      String? @default("")
  siteDescription  String? @default("")
  bookingFormStyle String? @default("v2")

  logo    String? @default("")
  favicon String? @default("")

  enableWhatsappChat Boolean? @default(false)
  whatsappNumber     String?  @default("")
  // Master kill switch for the Instagram grid. The feed itself lives in
  // instagram.prisma — this only decides whether the public site renders it.
  // (`instagramWidgetId` was dropped with the third-party-embed approach.)
  enableInstagram    Boolean? @default(false)

  // "Your local host" — the small looping avatar beside the WhatsApp button in
  // the FAQ block. It lives in site info, NOT on the homepage record, because
  // that block renders on the home, destination and collection pages; putting
  // it on one page's record would leave the other two on a bundled file.
  // Null on either → the site keeps its bundled avatar.
  faqHostImage String? // still frame, and the video's poster
  faqHostVideo String? // short loop; without one the still shows alone

  faqs Json? @default("[]")

  @@map("site_info")
}

// ─────────────────────────────────────────────────────────────────────────────
// SEO meta tags (singleton)
// ─────────────────────────────────────────────────────────────────────────────

model SiteSEO {
  id String @id @default("default")

  metaTitle       String? @default("")
  metaDescription String? @default("")
  metaKeywords    String? @default("")
  canonicalUrl    String? @default("")
  robotsMeta      String? @default("")

  ogTitle       String? @default("")
  ogDescription String? @default("")
  ogImage       String? @default("")

  twitterTitle       String? @default("")
  twitterDescription String? @default("")
  twitterImage       String? @default("")

  googleAnalyticsId   String? @default("")
  googleTagManagerId  String? @default("")
  googleSearchConsole String? @default("")
  facebookPixelId     String? @default("")
  cookiebotCbid       String? @default("")
  schemaType          String? @default("")
  customSchema        String? @default("")
  autoGenerateSitemap String? @default("")
  robotsTxt           String? @default("")

  @@map("site_seo")
}

// ─────────────────────────────────────────────────────────────────────────────
// Social media links (singleton)
// ─────────────────────────────────────────────────────────────────────────────

model SocialMedia {
  id String @id @default("default")

  facebookUrl  String? @default("")
  twitterUrl   String? @default("")
  linkedinUrl  String? @default("")
  instagramUrl String? @default("")
  youtubeUrl   String? @default("")
  tiktokUrl    String? @default("")

  @@map("social_media")
}

// ─────────────────────────────────────────────────────────────────────────────
// Mailchimp configuration (singleton)
// ─────────────────────────────────────────────────────────────────────────────

model Mailchimp {
  id String @id @default("default")

  apiKey       String? @default("")
  audienceId   String? @default("")
  serverPrefix String? @default("")

  @@map("mailchimp_configuration")
}

// ─────────────────────────────────────────────────────────────────────────────
// Company informations (singleton)
// ─────────────────────────────────────────────────────────────────────────────

model CompanyInformations {
  id String @id @default("default")

  companyName    String?
  companyEmail   String?
  companyPhone   String?
  companyWebsite String?
  companyAddress String?
  companyCity    String?
  companyState   String?
  companyZip     String?
  companyCountry String?
  companyVat     String?
  companySize    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_informations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Stripe configuration (singleton)
// ─────────────────────────────────────────────────────────────────────────────

model StripeConfiguration {
  id             String   @id @default("default")
  paymentLabel   String   @default("Stripe")
  publishableKey String   @default("")
  secretKey      String   @default("")
  webhookSecret  String   @default("")
  paymentMethods String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stripe_configuration")
}

// ─────────────────────────────────────────────────────────────────────────────
// Mollie configuration (singleton)
// ─────────────────────────────────────────────────────────────────────────────

model mollieConfiguration {
  id             String   @id @default("default")
  paymentLabel   String   @default("Mollie")
  apiKey         String   @default("")
  paymentMethods String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id])
  @@map("mollie_configuration")
}

// ─────────────────────────────────────────────────────────────────────────────
// Third-party platform reviews (Trustpilot / Google) — admin-configured
// (singleton). The fetched payload is cached here so public reads never hit
// the third-party API on the request path.
// ─────────────────────────────────────────────────────────────────────────────

model PlatformReviewsConfig {
  id String @id @default("default")

  // 'trustpilot' | 'google' — null = not configured
  provider   String?
  // Encrypted at rest (crypto.util) — Trustpilot API key / Google API key
  apiKey     String? @default("")
  // Trustpilot business-unit ID or Google Place ID
  businessId String? @default("")
  enabled    Boolean @default(false)

  // Where the section renders (page keys, e.g. ["homepage"])
  displayPages Json @default("[\"homepage\"]")

  // Normalized fetched payload + freshness stamp (lazy TTL refresh)
  cachedPayload Json?
  fetchedAt     DateTime?
  // Last fetch failure (surfaced to the admin; cleared on success)
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_reviews_config")
}
