// Better Auth tables — Phase 3
// @@map names must stay lowercase (Critical Rule #3 in CLAUDE.md)
// Do NOT rename: "user", "session", "account", "verification"

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  timezone      String   @default("UTC+06:00")
  phone         String?
  location      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Platform-specific fields
  role              Role       @default(TOUR_OPERATOR)
  status            UserStatus @default(ACTIVE)
  hasPassword       Boolean    @default(false)
  passwordChangedAt DateTime?

  // Internal-management accounts (the "supreme" system admin): hidden from
  // every listing endpoint and immune to admin mutation. Seed-only; never
  // exposed as a Better Auth additionalField, so it can't leak into sessions.
  isSystemAccount Boolean @default(false)

  // Relations
  sessions            Session[]
  operator            Operator?
  staffMember         StaffMember?
  staffInvitesSent    StaffMember[]  @relation("StaffInviter")
  accounts            Account[]
  media               MediaGallery[]
  bookings            Booking[]
  reviews             Review[]
  wishlists           Wishlist[]
  customerOf          Customer[]
  destinationsCreated Destination[]  @relation("DestinationCreator")
  hubsCreated         Hub[]          @relation("HubCreator")
  categoriesCreated   Category[]     @relation("CategoryCreator")
  collectionsCreated  Collection[]   @relation("CollectionCreator")

  passwordChangeRequest PasswordChangeRequest?

  @@index([id, email])
  @@index([role])
  @@map("user")
}

/// A password change that has been AUTHORISED (the current password was
/// verified) but not yet CONFIRMED from the account's mailbox. The password on
/// the credential account is untouched until the emailed link is used, so
/// knowing someone's password is not enough to take their account over - you
/// also need their inbox.
///
/// One row per user: requesting again replaces the pending change, which also
/// makes the previous link dead.
model PasswordChangeRequest {
  id     String @id @default(uuid())
  userId String @unique

  /// The already-hashed NEW password (Better Auth's own hasher). Plaintext is
  /// never stored, so this row leaks nothing a stolen DB does not already have.
  newPasswordHash String
  /// SHA-256 of the emailed token - the raw token exists only in the email.
  tokenHash       String   @unique
  expiresAt       DateTime
  /// Who asked, for the audit trail on a disputed change.
  requestedIp     String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_change_requests")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  // Which login door minted this session ('account'|'portal'|'staff'|'admin').
  // Null for sessions created outside /sign-in/email (email verification,
  // change-email) - consumers must treat null as "route by role".
  surface String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}
