// Content domain — slug routing, translations, editorial content, FAQ
// These models power the multilingual locale-aware URL system.

// ── Slug Registry ─────────────────────────────────────────────────────────────
// Resolves `/{locale}/{destination}/{slug}/` to the correct entity type.
// Each row is written in the same transaction as the entity it represents.
// Hub-anchored tours do NOT get a row here (URL structure is sufficient).
// 'tours' slug is pre-seeded as RESERVED for every destination.
model SlugRegistry {
  id              String         @id @default(uuid())
  destinationSlug String         // 'curacao' — matches Destination.slug
  slug            String         // 'boat-tours', 'klein-curacao', 'miss-ann'
  entityType      SlugEntityType // TOUR | CATEGORY | HUB | COLLECTION | RESERVED
  entityId        String?        // null only when entityType = RESERVED
  isActive        Boolean        @default(true)  // false = 404 but slug stays protected
  createdAt       DateTime       @default(now())

  @@unique([destinationSlug, slug])
  @@index([destinationSlug, slug, isActive])
  @@map("slug_registry")
}

// ── Translations ──────────────────────────────────────────────────────────────
// All dynamic multilingual content (EAV pattern).
// entityType: 'tour' | 'destination' | 'category' | 'hub'
// field: 'overview' | 'highlights' | 'h1_override' | 'breadcrumb_label' | 'name' | 'about_text' | 'meta_title' | 'meta_description'
// Fetch both requested locale + 'en' in one query, then merge (requested locale wins).
model Translation {
  id                 String   @id @default(uuid())
  entityType         String   // 'tour' | 'destination' | 'category' | 'hub'
  entityId           String   // UUID of the entity
  locale             String   // 'en' | 'es' | 'nl' | 'pt' | 'fr' | 'de' | 'zh'
  field              String   // field name
  value              String   // translated content (TEXT)
  isMachineTranslated Boolean @default(false)
  updatedAt          DateTime @updatedAt

  @@unique([entityType, entityId, locale, field])
  @@index([entityType, entityId, locale])
  @@map("translations")
}

// ── Page Content ──────────────────────────────────────────────────────────────
// Admin-managed editorial content per destination/category/hub page.
// e.g. "About boat tours in Curaçao" text blocks, meta tags.
model PageContent {
  id       String @id @default(uuid())
  pageType String // 'destination' | 'category' | 'hub'
  entityId String // UUID of the entity
  locale   String // 'en' | 'es' | ...
  field    String // 'about_text' | 'meta_title' | 'meta_description'
  value    String

  @@unique([pageType, entityId, locale, field])
  @@index([pageType, entityId, locale])
  @@map("page_content")
}

// ── FAQ ───────────────────────────────────────────────────────────────────────
// Admin-managed FAQ items attached to any entity page.
model Faq {
  id           String  @id @default(uuid())
  pageType     String  // 'destination' | 'category' | 'hub' | 'tour'
  entityId     String  // UUID of the entity
  locale       String  // 'en' | 'es' | ...
  question     String
  answer       String
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  @@index([pageType, entityId, locale])
  @@map("faqs")
}
