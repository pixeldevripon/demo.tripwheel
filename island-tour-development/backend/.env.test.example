PORT=5051
NODE_ENV=test
FRONTEND_URL='http://localhost:3000'
CORS_ORIGINS='http://localhost:3000'

# Separate test database — never point this at your dev or production DB
DATABASE_URL="postgresql://user:password@localhost:5432/island_tours_test"

# Better Auth — use a fixed test secret (min 32 chars, must not contain 'change-me')
BETTER_AUTH_SECRET="test-only-secret-replace-this-in-real-envs!!"
BETTER_AUTH_URL="http://localhost:5051"

# Review translation (LD32) - Google Cloud Translation v3. OPTIONAL: leave both
# unset and reviews simply display in the language the guest wrote them in.
# Needs the Cloud Translation API enabled on the project.
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_PROJECT_ID=
