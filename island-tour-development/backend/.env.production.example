the # ──────────────────────────────────────────────────────────────────────────────
# Backend APP secrets for the PRODUCTION docker-compose stack.
# Copy to backend/.env.production on the VPS and fill in.
#
#   cp backend/.env.production.example backend/.env.production
#
# IMPORTANT: do NOT set DATABASE_URL, REDIS_HOST, REDIS_PORT, REDIS_PASSWORD,
# NODE_ENV, PORT or RUN_SEED here - docker-compose.yml injects those from the
# root .env and they would be overridden anyway. Do NOT set UPSTASH_REDIS_URL
# (self-hosted Redis is used in production).
# ──────────────────────────────────────────────────────────────────────────────

# Public URLs - every emailed link has an explicit owner:
#   traveller links (TYP, /bookings, cancel)  -> ISLAND_TOURS_URL
#   operator links (/bookings in the dashboard,
#   invite set-password /portal/reset)        -> PORTAL_URL
#   calendar .ics                             -> PUBLIC_API_URL / BETTER_AUTH_URL
# FRONTEND_URL is legacy: consumed ONLY as the fallback when ISLAND_TOURS_URL
# is unset - with ISLAND_TOURS_URL set, its value has no effect on emails.
FRONTEND_URL=https://dashboard.tripwheel.app
# Operator portal (the separate dashboard app) incl. /portal path - the invite
# set-password email links to `${PORTAL_URL}/reset`, and operator emails link
# to `${PORTAL_URL minus /portal}/bookings`. No trailing slash/dot/whitespace:
# the value lands verbatim in emailed links.
PORTAL_URL=https://dashboard.tripwheel.app/portal
# Public traveller site origin - booking-email links (TYP, /bookings, cancel
# page). REQUIRED for correct traveller links (without it they fall back to
# FRONTEND_URL, which points at the dashboard). No trailing slash/dot/whitespace.
ISLAND_TOURS_URL=https://islandtours.tripwheel.app
# Every browser origin allowed to call the API (comma-separated, no spaces).
# Include the Vercel production domain AND any preview domains you use.
#
# MUST include the dashboard origin. The dashboard is a separate Vercel app on
# its own subdomain, and its API calls run in the browser with credentials, so
# omitting it blocks every dashboard request AND (via Better Auth
# trustedOrigins) rejects operator/admin sign-in - and Better Auth also
# validates the invite reset's redirectTo against this list.
CORS_ORIGINS=https://islandtours.tripwheel.app,https://dashboard.tripwheel.app,https://admin.your-domain.com

# Better Auth
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_at_least_32_characters_long
# The PUBLIC backend URL (where nginx serves the API), used to build auth links.
BETTER_AUTH_URL=https://api.your-domain.com

# OPTIONAL. Public origin used to build API links that travellers open from OUTSIDE
# the app - currently the confirmation email's "Add to calendar" (.ics) link, which
# is clicked in a mail client with no session. Defaults to BETTER_AUTH_URL, which is
# correct whenever the API is served from a single public host. Set this only if the
# API is fronted by a different hostname than the one Better Auth uses.
# PUBLIC_API_URL=https://api.your-domain.com

# Session-cookie domain shared between the app and API subdomains in production
# (crossSubDomainCookies). Scope it to THIS project's apex - the smallest domain
# that covers both the frontend and backend hosts - NOT a broader shared apex, or
# the session cookie leaks to every unrelated sibling subdomain. Must start with a
# leading dot. Example for app=islandtours.esenc.cloud / api=api.islandtours.esenc.cloud:
COOKIE_DOMAIN=.your-project.your-domain.com

# Trusted-origin bypass for the per-IP throttle. The SSR/build server (frontend)
# sends this as `x-internal-api-key` so its prerender bursts are not rate-limited.
# REQUIRED in production; must match the frontend's server-only INTERNAL_API_SECRET.
# Generate: openssl rand -base64 32 (min 32 chars)
INTERNAL_API_SECRET=CHANGE_ME_at_least_32_characters
# Signs traveler session tokens (email + booking-reference login, full TYP,
# cancellation request). REQUIRED and dedicated - no fallback to
# BETTER_AUTH_SECRET, so the two token systems have independent keys and either
# can be rotated without touching the other. Generate: openssl rand -base64 32
TRAVELER_SESSION_SECRET=CHANGE_ME_at_least_32_characters

# Cross-app cache busting: sent as `x-revalidate-secret` to the public site's
# POST /api/revalidate when nightly jobs re-rank tours (target = ISLAND_TOURS_URL).
# Must be one of the values in the frontend's comma-separated REVALIDATE_SECRET -
# without it, nightly re-ranking only reaches public pages when cacheLife timers
# expire (up to a day). Generate: openssl rand -base64 32 (min 32 chars)
REVALIDATE_SECRET=CHANGE_ME_at_least_32_characters

# Google OAuth (optional - omit both to disable Google sign-in)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Admin seeding (RUN_SEED=true on first boot) + operations: this inbox also
# receives traveller cancellation requests from the /cancel/{publicRef} form (B3).
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=CHANGE_ME_min_12_chars

# Hidden internal-management admin (optional): same powers as ADMIN_EMAIL but
# flagged isSystemAccount - never listed anywhere, immune to admin mutation.
# Unset = the seed skips it. Keep these credentials with the internal
# management department only.
SYSTEM_ADMIN_EMAIL=internal-admin@your-domain.com
SYSTEM_ADMIN_PASSWORD=CHANGE_ME_min_12_chars

# Email (Resend) - the only email configuration; there is no dashboard surface.
# The MAIL_FROM domain must be verified in your Resend account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Quote the WHOLE value (display name + address) - docker compose env_file
# parsing rejects an unquoted space/`<` outside quotes.
MAIL_FROM="Island Tours <noreply@tripwheel.app>"

# Encryption (settings & operator OAuth token storage)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_64_char_hex_from_openssl_rand_hex_32

# AI translation (content entities + review comments). Provider-agnostic:
# gemini | anthropic | openai | groq | openrouter | mistral | deepseek |
# custom (+ TRANSLATION_BASE_URL for any OpenAI-compatible endpoint). Default
# gemini (key from https://aistudio.google.com/apikey, model default
# gemini-2.5-flash-lite). OPTIONAL: without a key the feature is inert and
# content/reviews display in their source language. The dashboard
# (Settings > Integrations) values win.
TRANSLATION_PROVIDER_NAME=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=
TRANSLATION_BASE_URL=

# Cloudinary (Media Gallery)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payments & tracking
# Stripe keys are NOT here - they live encrypted in the DB (Admin -> Settings).
#
# FX provider for the rate cache feed. Set 'ecb' in production for real keyless ECB
# reference rates (Frankfurter, no key); on a provider outage production fails closed
# for cross-currency checkout (never serves the static rate). 'static' keeps the fixed
# FX_USD_TO_EUR rate. The CHARGE rate comes from Stripe (payments phase), not this feed.
FX_PROVIDER=ecb
# Static USD -> EUR rate: the EUR commission normalization (rule #22) + the 'static' provider.
FX_USD_TO_EUR=0.92
# Meta Conversions API (both required, or omit both)
META_PIXEL_ID=000000000000000
META_CAPI_TOKEN=your-system-user-access-token
# Omit META_CAPI_TEST_CODE in production (it routes events to Meta's test tool).
#
# Instagram feed auto-sync (Instagram API with Instagram Login) is configured
# ENTIRELY from the DASHBOARD (Settings > Instagram): an admin pastes a
# long-lived access token there and the account syncs directly - no OAuth, no
# redirect, no App Review. It is stored encrypted in the database and rotated
# there by the nightly refresh. There is deliberately NO INSTAGRAM_ACCESS_TOKEN
# env var.
