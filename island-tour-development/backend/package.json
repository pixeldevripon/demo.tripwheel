{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "build:prod": "prisma generate && prisma migrate deploy && pnpm prisma:seed && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "prisma generate && nest start",
    "start:dev": "prisma generate && nest start --watch",
    "start:debug": "prisma generate && nest start --debug --watch",
    "start:prod": "if [ -f dist/src/main.js ]; then node dist/src/main.js; else node dist/main.js; fi",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:verbose": "jest --verbose",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules' jest --config ./test/jest-e2e.json",
    "test:e2e:setup": "cp .env.test.example .env.test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "email:icons:upload": "ts-node -r tsconfig-paths/register scripts/upload-email-icons.ts",
    "media:backfill": "ts-node -r tsconfig-paths/register scripts/backfill-media-metadata.ts",
    "booking:island:backfill": "ts-node -r tsconfig-paths/register scripts/backfill-booking-island.ts",
    "home:media:seed": "ts-node -r tsconfig-paths/register scripts/seed-home-page-media.ts",
    "pages:seed": "ts-node -r tsconfig-paths/register scripts/seed-pages.ts",
    "prisma:seed:demo": "ts-node -r tsconfig-paths/register prisma/demo-seed.ts",
    "prisma:seed:demo:clean": "ts-node -r tsconfig-paths/register prisma/demo-seed.ts --clean",
    "prisma:seed:demo:tour-titles": "ts-node -r tsconfig-paths/register prisma/seed-tour-titles.ts",
    "prisma:seed:demo:tour-titles:dry": "ts-node -r tsconfig-paths/register prisma/seed-tour-titles.ts --dry-run",
    "prisma:seed:recommendations": "ts-node -r tsconfig-paths/register prisma/seed-recommendations.ts",
    "prisma:seed:recommendations:clean": "ts-node -r tsconfig-paths/register prisma/seed-recommendations.ts --clean",
    "prisma:seed:designations": "ts-node -r tsconfig-paths/register prisma/seed-designations.ts",
    "prisma:seed:designations:clean": "ts-node -r tsconfig-paths/register prisma/seed-designations.ts --clean",
    "prisma:format": "prisma format",
    "email:preview": "ts-node -r tsconfig-paths/register scripts/render-email-preview.ts"
  },
  "dependencies": {
    "@mollie/api-client": "^4.6.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/multer": "^2.1.0",
    "better-auth": "^1.6.9",
    "bullmq": "^5.76.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.10.0",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "htmlparser2": "^8.0.2",
    "libphonenumber-js": "^1.13.9",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.17.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.16.0",
    "stripe": "^22.2.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@jest/globals": "^30.4.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ]
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
