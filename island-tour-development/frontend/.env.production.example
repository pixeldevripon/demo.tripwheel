# Dev: http://localhost:5050 — Production: your Render backend URL


#using this from proxy so that croos domain cookie not cerate an issue
#NEXT_PUBLIC_BACKEND_URL='http://localhost:5050'
NEXT_PUBLIC_BACKEND_URL='https://island-tours.vercel.app'
# Server-only shared secret sent on SSR/build data fetches so the backend exempts
# this trusted origin from its per-IP throttle. Must match the backend's
# INTERNAL_API_SECRET. NOT prefixed NEXT_PUBLIC_ - it must never reach the browser.
INTERNAL_API_SECRET='change-me-at-least-16-characters'

NEXT_PUBLIC_OPEN_WEATHER_API_KEY=""
NEXT_PUBLIC_BACKEND_URL='http://localhost:5050'

# Shared secret guarding POST /api/revalidate - the endpoint the dashboard calls
# to bust this app's 'use cache' entries after an operator writes. Must match the
# dashboard's REVALIDATE_SECRET. Server-only; never NEXT_PUBLIC_. 32+ chars.
#
# Accepts a COMMA-SEPARATED LIST, so rotation is two ordinary deploys rather than
# a synchronized flag-day: add the new value here (both accepted) -> switch the
# dashboard -> drop the old value here.
#
# A mismatch is not loud on this side: the dashboard logs the 401 and the write
# still succeeds. What breaks is that this app keeps serving stale prices.
REVALIDATE_SECRET='set-me-to-the-dashboard-value'

# Cookiebot domain group ID (Manage > Settings > Your scripts in the Cookiebot
# admin, login info@island.tours). Unset = no consent banner and the Manage
# Cookies button shows a "not available yet" note instead of the dialog.
NEXT_PUBLIC_COOKIEBOT_CBID=''