# Dev: http://localhost:5050 — Production: your Render backend URL
NEXT_PUBLIC_BACKEND_URL='http://localhost:5050'

# Server-only shared secret sent on SSR/build data fetches so the backend exempts
# this trusted origin from its per-IP throttle. Must match the backend's
# INTERNAL_API_SECRET. NOT prefixed NEXT_PUBLIC_ - it must never reach the browser.
INTERNAL_API_SECRET='change-me-at-least-16-characters'

NEXT_PUBLIC_OPEN_WEATHER_API_KEY=""

# Shared secret guarding POST /api/revalidate, the endpoint the dashboard calls
# to bust this app's 'use cache' entries after a write. Must match the
# dashboard's REVALIDATE_SECRET. Server-only; never NEXT_PUBLIC_.
#
# Accepts a COMMA-SEPARATED LIST so the secret can be rotated without a
# flag-day: add the new value here and deploy (both are now accepted), point the
# dashboard at the new one, then drop the old value here.
#
# Unset = every revalidation 401s and this app silently serves stale pages.
REVALIDATE_SECRET='change-me-at-least-32-characters-long'


# Cookiebot domain group ID - local-dev fallback only. The primary source is
# the dashboard (Settings > SEO & Tracking > Cookiebot Domain Group ID), which
# overrides this. Unset both = no consent banner and the Manage Cookies button
# shows a "not available yet" note instead of the dialog.
NEXT_PUBLIC_COOKIEBOT_CBID=''

# Admin login app (separate origin) - logout redirect target for ADMIN users.
NEXT_PUBLIC_ADMIN_LOGIN_URL='http://localhost:3002'

#Tour operator portal app (separate origin) - logout redirect target for TOUR_OPERATOR users.
NEXT_PUBLIC_PORTAL_URL='http://localhost:3001/portal'