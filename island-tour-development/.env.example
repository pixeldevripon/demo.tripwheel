# ──────────────────────────────────────────────────────────────────────────────
# COMPOSE-LEVEL env for the PRODUCTION stack (docker-compose.yml).
# Copy to `.env` on the VPS and fill in. This file holds ONLY the infrastructure
# variables that docker-compose interpolates. The backend's own app secrets live
# in backend/.env.production (see backend/.env.production.example).
#
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# Postgres (the compose `postgres` service is created with these credentials,
# and the backend's DATABASE_URL is assembled from them automatically).
POSTGRES_USER=island
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=island_tours

# Redis (the compose `redis` service runs with --requirepass this value, and the
# backend connects with it). Generate: openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# Backend container
# Loopback port nginx proxies to (host side). Keep on 127.0.0.1 in compose.
BACKEND_PORT=5050
# Image tag (CI sets this to the git SHA; defaults to `latest` locally).
BACKEND_IMAGE_TAG=latest
# Set to `true` for the FIRST deploy against an empty DB to run the prod seed
# (creates the admin user). Set back to `false` afterwards so redeploys don't reseed.
RUN_SEED=false
